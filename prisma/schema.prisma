generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                        String                   @id @default(uuid()) @db.Char(36)
  email                     String                   @unique @db.VarChar(255)
  username                  String?                  @unique @db.VarChar(100)
  phone                     String?                  @db.VarChar(50)
  firstName                 String                   @db.VarChar(100)
  lastName                  String                   @db.VarChar(100)
  password                  String                   @db.VarChar(255)
  avatarUrl                 String?                  @db.VarChar(255)
  status                    UserStatus               @default(PENDING)
  roleId                    String?                  @db.Char(36)
  departmentId              String?                  @db.Char(36)
  designationId             String?                  @db.Char(36)
  createdAt                 DateTime                 @default(now()) @db.Timestamp(0)
  updatedAt                 DateTime                 @updatedAt @db.Timestamp(0)
  deletedAt                 DateTime?                @db.Timestamp(0)
  createdBy                 String?                  @db.Char(36)
  updatedBy                 String?                  @db.Char(36)
  deletedBy                 String?                  @db.Char(36)
  address                   String?                  @db.Text
  salaryMonthly             Decimal?                 @db.Decimal(10, 2)
  joiningDate               DateTime?                @db.Date
  version                   Int                      @default(0)
  backupCodes               Json?
  emailVerificationToken    String?                  @db.VarChar(255)
  emailVerifiedAt           DateTime?                @db.Timestamp(0)
  failedLoginAttempts       Int                      @default(0)
  lastLoginAt               DateTime?                @db.Timestamp(0)
  lastPasswordChangedAt     DateTime?                @db.Timestamp(0)
  lockedUntil               DateTime?                @db.Timestamp(0)
  mfaEnabled                Boolean                  @default(false)
  mfaSecret                 String?                  @db.VarChar(255)
  isTrackingEnabled         Boolean                  @default(true)
  announcements             Announcement[]           @relation("AnnouncementCreator")
  developerApplications     DeveloperApplication[]
  apiKeys                   ApiKey[]
  apiLogs                   ApiLog[]
  oauthApplications         OAuthApplication[]
  webhooks                  Webhook[]
  approvalRequests          ApprovalRequest[]        @relation("ApproverUser")
  billableRates             BillableRate[]
  communicationLogs         CommunicationLog[]
  dailyTimesheets           DailyTimesheet[]
  dashboardShares           DashboardShare[]
  dashboards                Dashboard[]
  deputyDepartments         Department[]             @relation("DepartmentDeputy")
  managedDepartments        Department[]             @relation("DepartmentManager")
  deploymentsStarted        Deployment[]             @relation("UserDeployments")
  employeeProfile           EmployeeProfile?
  expenses                  Expense[]
  createdAssignments        LeadAssignment[]         @relation("LeadAssigner")
  assignedLeads             LeadAssignment[]         @relation("LeadAssignee")
  transferredAssignments    LeadAssignment[]         @relation("LeadTransferrer")
  ownedLeads                Lead[]                   @relation("LeadOwner")
  leaveApprovals            LeaveApproval[]          @relation("LeaveRequestApprover")
  notificationPreferences   NotificationPreference[]
  notifications             Notification[]           @relation("UserNotification")
  ownedOpportunities        Opportunity[]            @relation("OpportunityOwner")
  passwordHistories         PasswordHistory[]
  passwordResetTokens       PasswordResetToken[]
  managerPerformanceReviews PerformanceReview[]      @relation("PerformanceManagerReviewer")
  productivityScores        ProductivityScore[]
  assignedIssues            ProjectIssue[]           @relation("IssueAssignee")
  projectMemberships        ProjectMember[]
  assignedMilestones        ProjectMilestone[]       @relation("MilestoneOwner")
  resourceAllocations       ProjectResource[]
  ownedRisks                ProjectRisk[]            @relation("RiskOwner")
  managedProjects           Project[]                @relation("ProjectManager")
  proposalsApproved         ProposalApproval[]       @relation("ProposalApprover")
  proposalVersionsCreated   ProposalVersion[]        @relation("ProposalVersionCreator")
  proposalPDFsGenerated     Proposal[]               @relation("ProposalPDFGenerator")
  recentReports             RecentlyOpenedReport[]
  reportExecutions          ReportExecution[]
  reportExports             ReportExport[]
  reportFavorites           ReportFavorite[]
  reportVersions            ReportVersion[]          @relation("UserReportVersions")
  savedFilters              SavedFilter[]
  scheduledReports          ScheduledReport[]
  seoProjects               SEOProject[]             @relation("UserSeoProjects")
  seoReports                SEOReport[]
  uploadedAttachments       TaskAttachment[]         @relation("TaskAttachmentUploader")
  taskComments              TaskComment[]            @relation("TaskCommentAuthor")
  taskTimers                TaskTimer[]
  watchedTasks              TaskWatcher[]            @relation("TaskWatcherUser")
  ledTeams                  Team[]                   @relation("TeamLead")
  timeEntries               TimeEntry[]
  timesheetApprovals        TimesheetApproval[]      @relation("TimesheetApprover")
  preferences               UserPreference?
  sessions                  UserSession[]
  teams                     UserTeam[]
  department                Department?              @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: Restrict)
  designation               Designation?             @relation(fields: [designationId], references: [id], onDelete: Restrict)
  role                      Role?                    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  companyId                 String?                  @db.Char(36)
  company                   Company?                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  utilizationReports        UtilizationReport[]
  weeklyTimesheets          WeeklyTimesheet[]
  workSessions              WorkSession[]
  workflowExecutions        WorkflowExecution[]
  tasks                     Task[]                   @relation("taskassignees")
  
  seoLogs                 SEODailyWorkLog[]        @relation("UserSeoLogs")
  seoLogsCreated          SEODailyWorkLog[]        @relation("UserSeoLogsCreated")
  seoLogsUpdated          SEODailyWorkLog[]        @relation("UserSeoLogsUpdated")
  seoLogsApproved         SEODailyWorkLog[]        @relation("UserSeoLogsApproved")
  seoLogsRejected         SEODailyWorkLog[]        @relation("UserSeoLogsRejected")
  seoTargets              SEOMonthlyTarget[]       @relation("UserSeoTargets")
  assignedSeoTasks        SEOTask[]                @relation("UserAssignedSeoTasks")
  createdSeoTasks         SEOTask[]                @relation("UserCreatedSeoTasks")
  seoTaskTimelines        SEOTaskTimeline[]
  assignedSeoReminders    SEOReminder[]            @relation("UserAssignedSeoReminders")
  createdSeoReminders     SEOReminder[]            @relation("UserCreatedSeoReminders")

  @@index([status])
  @@index([departmentId], map: "users_departmentId_fkey")
  @@index([designationId], map: "users_designationId_fkey")
  @@index([roleId], map: "users_roleId_fkey")
  @@index([companyId], map: "users_companyId_fkey")
  @@map("users")
}

model UserPreference {
  id                   String    @id @default(uuid()) @db.Char(36)
  userId               String    @unique @db.Char(36)
  theme                String    @default("light") @db.VarChar(20)
  language             String    @default("en") @db.VarChar(10)
  timezone             String    @default("Asia/Kolkata") @db.VarChar(50)
  notificationsEnabled Boolean   @default(true)
  createdAt            DateTime  @default(now()) @db.Timestamp(0)
  updatedAt            DateTime  @updatedAt @db.Timestamp(0)
  deletedAt            DateTime? @db.Timestamp(0)
  createdBy            String?   @db.Char(36)
  updatedBy            String?   @db.Char(36)
  deletedBy            String?   @db.Char(36)
  version              Int       @default(0)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Role {
  id                      String                   @id @default(uuid()) @db.Char(36)
  name                    String                   @unique @db.VarChar(100)
  description             String?                  @db.VarChar(255)
  isSystem                Boolean                  @default(false)
  parentId                String?                  @db.Char(36)
  createdAt               DateTime                 @default(now()) @db.Timestamp(0)
  updatedAt               DateTime                 @updatedAt @db.Timestamp(0)
  deletedAt               DateTime?                @db.Timestamp(0)
  createdBy               String?                  @db.Char(36)
  updatedBy               String?                  @db.Char(36)
  deletedBy               String?                  @db.Char(36)
  version                 Int                      @default(0)
  dashboardShares         DashboardShare[]
  notificationPreferences NotificationPreference[]
  parent                  Role?                    @relation("RoleHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                Role[]                   @relation("RoleHierarchy")
  users                   User[]
  permissions             Permission[]             @relation("rolepermissions")

  @@index([parentId], map: "roles_parentId_fkey")
  @@map("roles")
}

model PermissionGroup {
  id          String               @id @default(uuid()) @db.Char(36)
  name        String               @unique @db.VarChar(100)
  description String?              @db.VarChar(255)
  createdAt   DateTime             @default(now()) @db.Timestamp(0)
  updatedAt   DateTime             @updatedAt @db.Timestamp(0)
  deletedAt   DateTime?            @db.Timestamp(0)
  createdBy   String?              @db.Char(36)
  updatedBy   String?              @db.Char(36)
  deletedBy   String?              @db.Char(36)
  version     Int                  @default(0)
  categories  PermissionCategory[]

  @@map("permission_groups")
}

model PermissionCategory {
  id          String          @id @default(uuid()) @db.Char(36)
  name        String          @unique @db.VarChar(100)
  description String?         @db.VarChar(255)
  groupId     String          @db.Char(36)
  createdAt   DateTime        @default(now()) @db.Timestamp(0)
  updatedAt   DateTime        @updatedAt @db.Timestamp(0)
  deletedAt   DateTime?       @db.Timestamp(0)
  createdBy   String?         @db.Char(36)
  updatedBy   String?         @db.Char(36)
  deletedBy   String?         @db.Char(36)
  version     Int             @default(0)
  group       PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permissions Permission[]

  @@index([groupId], map: "permission_categories_groupId_fkey")
  @@map("permission_categories")
}

model Permission {
  id         String             @id @default(uuid()) @db.Char(36)
  name       String             @unique @db.VarChar(100)
  code       String             @unique @db.VarChar(100)
  categoryId String             @db.Char(36)
  createdAt  DateTime           @default(now()) @db.Timestamp(0)
  updatedAt  DateTime           @updatedAt @db.Timestamp(0)
  deletedAt  DateTime?          @db.Timestamp(0)
  createdBy  String?            @db.Char(36)
  updatedBy  String?            @db.Char(36)
  deletedBy  String?            @db.Char(36)
  version    Int                @default(0)
  category   PermissionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  roles      Role[]             @relation("rolepermissions")

  @@index([categoryId], map: "permissions_categoryId_fkey")
  @@map("permissions")
}

model Department {
  id              String         @id @default(uuid()) @db.Char(36)
  name            String         @unique @db.VarChar(100)
  code            String         @unique @db.VarChar(50)
  displayOrder    Int            @default(0)
  isRoot          Boolean        @default(false)
  status          Status         @default(ACTIVE)
  parentId        String?        @db.Char(36)
  managerId       String?        @db.Char(36)
  deputyManagerId String?        @db.Char(36)
  createdAt       DateTime       @default(now()) @db.Timestamp(0)
  updatedAt       DateTime       @updatedAt @db.Timestamp(0)
  deletedAt       DateTime?      @db.Timestamp(0)
  createdBy       String?        @db.Char(36)
  updatedBy       String?        @db.Char(36)
  deletedBy       String?        @db.Char(36)
  version         Int            @default(0)
  announcements   Announcement[] @relation("DepartmentAnnouncements")
  deputyManager   User?          @relation("DepartmentDeputy", fields: [deputyManagerId], references: [id], onDelete: Restrict)
  manager         User?          @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: Restrict)
  parent          Department?    @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        Department[]   @relation("DepartmentHierarchy")
  designations    Designation[]
  savedFilters    SavedFilter[]
  users           User[]         @relation("DepartmentMembers")

  @@index([deputyManagerId], map: "departments_deputyManagerId_fkey")
  @@index([managerId], map: "departments_managerId_fkey")
  @@index([parentId], map: "departments_parentId_fkey")
  @@map("departments")
}

model Team {
  id          String     @id @default(uuid()) @db.Char(36)
  name        String     @unique @db.VarChar(100)
  code        String     @unique @db.VarChar(50)
  description String?    @db.VarChar(255)
  status      Status     @default(ACTIVE)
  leadId      String?    @db.Char(36)
  createdAt   DateTime   @default(now()) @db.Timestamp(0)
  updatedAt   DateTime   @updatedAt @db.Timestamp(0)
  deletedAt   DateTime?  @db.Timestamp(0)
  createdBy   String?    @db.Char(36)
  updatedBy   String?    @db.Char(36)
  deletedBy   String?    @db.Char(36)
  version     Int        @default(0)
  lead        User?      @relation("TeamLead", fields: [leadId], references: [id], onDelete: Restrict)
  members     UserTeam[]

  @@index([leadId], map: "teams_leadId_fkey")
  @@map("teams")
}

model UserTeam {
  userId     String   @db.Char(36)
  teamId     String   @db.Char(36)
  roleInTeam String   @default("member") @db.VarChar(50)
  createdAt  DateTime @default(now()) @db.Timestamp(0)
  updatedAt  DateTime @updatedAt @db.Timestamp(0)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@index([teamId], map: "user_teams_teamId_fkey")
  @@map("user_teams")
}

model Designation {
  id           String      @id @default(uuid()) @db.Char(36)
  name         String      @unique @db.VarChar(100)
  code         String      @unique @db.VarChar(50)
  description  String?     @db.VarChar(255)
  sortOrder    Int         @default(0)
  status       Status      @default(ACTIVE)
  departmentId String?     @db.Char(36)
  createdAt    DateTime    @default(now()) @db.Timestamp(0)
  updatedAt    DateTime    @updatedAt @db.Timestamp(0)
  deletedAt    DateTime?   @db.Timestamp(0)
  createdBy    String?     @db.Char(36)
  updatedBy    String?     @db.Char(36)
  deletedBy    String?     @db.Char(36)
  version      Int         @default(0)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  users        User[]

  @@index([departmentId], map: "designations_departmentId_fkey")
  @@map("designations")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String    @db.Char(36)
  refreshTokenHash String    @db.VarChar(255)
  deviceName       String?   @db.VarChar(100)
  deviceType       String?   @db.VarChar(50)
  browser          String?   @db.VarChar(100)
  operatingSystem  String?   @db.VarChar(100)
  ipAddress        String?   @db.VarChar(50)
  userAgent        String?   @db.VarChar(255)
  lastActivityAt   DateTime  @default(now()) @db.Timestamp(0)
  revokedAt        DateTime? @db.Timestamp(0)
  expiresAt        DateTime  @db.Timestamp(0)
  createdAt        DateTime  @default(now()) @db.Timestamp(0)
  updatedAt        DateTime  @updatedAt @db.Timestamp(0)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Char(36)
  userId       String   @db.Char(36)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now()) @db.Timestamp(0)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_histories")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime  @db.Timestamp(0)
  usedAt    DateTime? @db.Timestamp(0)
  createdAt DateTime  @default(now()) @db.Timestamp(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model ClientCategory {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @unique @db.VarChar(100)
  code        String    @unique @db.VarChar(50)
  description String?   @db.VarChar(255)
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now()) @db.Timestamp(0)
  updatedAt   DateTime  @updatedAt @db.Timestamp(0)
  deletedAt   DateTime? @db.Timestamp(0)
  createdBy   String?   @db.Char(36)
  updatedBy   String?   @db.Char(36)
  deletedBy   String?   @db.Char(36)
  version     Int       @default(0)
  clients     Client[]

  @@map("client_categories")
}

model Client {
  id                 String             @id @default(uuid()) @db.Char(36)
  name               String             @db.VarChar(255)
  code               String             @unique @db.VarChar(100)
  status             ClientStatus       @default(PROSPECT)
  industry           String?            @db.VarChar(100)
  companyType        String?            @db.VarChar(100)
  website            String?            @db.VarChar(255)
  gstVatNumber       String?            @db.VarChar(50)
  taxNumber          String?            @db.VarChar(50)
  registrationNumber String?            @db.VarChar(100)
  profileLogo        String?            @db.VarChar(255)
  remarks            String?            @db.Text
  categoryId         String             @db.Char(36)
  primaryContactId   String?            @db.Char(36)
  primaryAddressId   String?            @db.Char(36)
  createdAt          DateTime           @default(now()) @db.Timestamp(0)
  updatedAt          DateTime           @updatedAt @db.Timestamp(0)
  deletedAt          DateTime?          @db.Timestamp(0)
  createdBy          String?            @db.Char(36)
  updatedBy          String?            @db.Char(36)
  deletedBy          String?            @db.Char(36)
  version            Int                @default(0)
  tags               ClientTag[]        @relation("ClientToTags")
  integrations       Integration[]
  billableRates      BillableRate[]
  addresses          ClientAddress[]    @relation("ClientToAddresses")
  contacts           ClientContact[]    @relation("ClientToContacts")
  contracts          ClientContract[]
  documents          ClientDocument[]
  notes              ClientNote[]
  timelines          ClientTimeline[]
  category           ClientCategory     @relation(fields: [categoryId], references: [id])
  primaryAddress     ClientAddress?     @relation("PrimaryAddress", fields: [primaryAddressId], references: [id])
  primaryContact     ClientContact?     @relation("PrimaryContact", fields: [primaryContactId], references: [id])
  domains            Domain[]
  estimates          Estimate[]
  hostingAccounts    HostingAccount[]
  invoices           Invoice[]
  opportunities      Opportunity[]
  projects           Project[]
  recurringInvoices  RecurringInvoice[]
  seoProjects        SEOProject[]
  servers            Server[]

  @@index([status])
  @@index([categoryId])
  @@index([primaryAddressId], map: "clients_primaryAddressId_fkey")
  @@index([primaryContactId], map: "clients_primaryContactId_fkey")
  @@map("clients")
}

model ClientContact {
  id                     String    @id @default(uuid()) @db.Char(36)
  clientId               String    @db.Char(36)
  name                   String    @db.VarChar(255)
  designation            String?   @db.VarChar(100)
  email                  String    @db.VarChar(255)
  mobile                 String?   @db.VarChar(50)
  officePhone            String?   @db.VarChar(50)
  whatsApp               String?   @db.VarChar(50)
  birthday               DateTime? @db.Date
  notes                  String?   @db.Text
  status                 Status    @default(ACTIVE)
  isPrimary              Boolean   @default(false)
  linkedIn               String?   @db.VarChar(255)
  preferredContactMethod String?   @db.VarChar(50)
  preferredContactTime   String?   @db.VarChar(100)
  createdAt              DateTime  @default(now()) @db.Timestamp(0)
  updatedAt              DateTime  @updatedAt @db.Timestamp(0)
  deletedAt              DateTime? @db.Timestamp(0)
  createdBy              String?   @db.Char(36)
  updatedBy              String?   @db.Char(36)
  deletedBy              String?   @db.Char(36)
  version                Int       @default(0)
  client                 Client    @relation("ClientToContacts", fields: [clientId], references: [id], onDelete: Cascade)
  primaryForClients      Client[]  @relation("PrimaryContact")

  @@index([clientId])
  @@index([email])
  @@map("client_contacts")
}

model ClientAddress {
  id                String      @id @default(uuid()) @db.Char(36)
  clientId          String      @db.Char(36)
  type              AddressType @default(BILLING)
  addressLine1      String      @db.VarChar(255)
  addressLine2      String?     @db.VarChar(255)
  city              String      @db.VarChar(100)
  state             String?     @db.VarChar(100)
  postalCode        String      @db.VarChar(20)
  country           String      @db.VarChar(100)
  isPrimary         Boolean     @default(false)
  latitude          Decimal?    @db.Decimal(10, 8)
  longitude         Decimal?    @db.Decimal(11, 8)
  googleMapsUrl     String?     @db.VarChar(512)
  createdAt         DateTime    @default(now()) @db.Timestamp(0)
  updatedAt         DateTime    @updatedAt @db.Timestamp(0)
  deletedAt         DateTime?   @db.Timestamp(0)
  createdBy         String?     @db.Char(36)
  updatedBy         String?     @db.Char(36)
  deletedBy         String?     @db.Char(36)
  version           Int         @default(0)
  client            Client      @relation("ClientToAddresses", fields: [clientId], references: [id], onDelete: Cascade)
  primaryForClients Client[]    @relation("PrimaryAddress")

  @@index([clientId])
  @@map("client_addresses")
}

model ClientDocument {
  id              String           @id @default(uuid()) @db.Char(36)
  clientId        String           @db.Char(36)
  fileName        String           @db.VarChar(255)
  fileKey         String           @db.VarChar(255)
  mimeType        String?          @db.VarChar(100)
  fileSize        Int?
  documentVersion String           @default("1.0") @db.VarChar(20)
  category        DocumentCategory @default(OTHER)
  expiryDate      DateTime?        @db.Date
  reminderDate    DateTime?        @db.Date
  uploadDate      DateTime         @default(now()) @db.Timestamp(0)
  uploadedBy      String           @db.Char(36)
  createdAt       DateTime         @default(now()) @db.Timestamp(0)
  updatedAt       DateTime         @updatedAt @db.Timestamp(0)
  deletedAt       DateTime?        @db.Timestamp(0)
  createdBy       String?          @db.Char(36)
  updatedBy       String?          @db.Char(36)
  deletedBy       String?          @db.Char(36)
  version         Int              @default(0)
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_documents")
}

model ClientContract {
  id                String         @id @default(uuid()) @db.Char(36)
  clientId          String         @db.Char(36)
  contractNumber    String         @unique @db.VarChar(100)
  startDate         DateTime       @db.Date
  endDate           DateTime       @db.Date
  renewalDate       DateTime?      @db.Date
  status            ContractStatus @default(DRAFT)
  renewalReminder   Boolean        @default(false)
  documentReference String?        @db.VarChar(255)
  contractValue     Decimal?       @db.Decimal(15, 2)
  currency          String?        @default("INR") @db.VarChar(10)
  autoRenewal       Boolean        @default(false)
  noticePeriod      Int?
  renewalOwnerId    String?        @db.Char(36)
  createdAt         DateTime       @default(now()) @db.Timestamp(0)
  updatedAt         DateTime       @updatedAt @db.Timestamp(0)
  deletedAt         DateTime?      @db.Timestamp(0)
  createdBy         String?        @db.Char(36)
  updatedBy         String?        @db.Char(36)
  deletedBy         String?        @db.Char(36)
  version           Int            @default(0)
  client            Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contracts")
}

model ClientNote {
  id                   String    @id @default(uuid()) @db.Char(36)
  clientId             String    @db.Char(36)
  title                String?   @db.VarChar(255)
  content              String    @db.Text
  type                 NoteType  @default(INTERNAL)
  attachmentsReference Json?
  pinned               Boolean   @default(false)
  private              Boolean   @default(false)
  mentions             Json?
  createdAt            DateTime  @default(now()) @db.Timestamp(0)
  updatedAt            DateTime  @updatedAt @db.Timestamp(0)
  deletedAt            DateTime? @db.Timestamp(0)
  createdBy            String?   @db.Char(36)
  updatedBy            String?   @db.Char(36)
  deletedBy            String?   @db.Char(36)
  version              Int       @default(0)
  client               Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_notes")
}

model ClientTag {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamp(0)
  updatedAt DateTime @updatedAt @db.Timestamp(0)
  clients   Client[] @relation("ClientToTags")

  @@map("client_tags")
}

model ClientTimeline {
  id          String   @id @default(uuid()) @db.Char(36)
  clientId    String   @db.Char(36)
