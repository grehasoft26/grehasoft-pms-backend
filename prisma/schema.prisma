// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ----------------------------------------------------
// Enums
// ----------------------------------------------------

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
  ARCHIVED
}

enum Status {
  ACTIVE
  INACTIVE
}

// ----------------------------------------------------
// Global Settings
// ----------------------------------------------------

model SystemSetting {
  id    String @id @default(uuid()) @db.Char(36)
  key   String @unique @db.VarChar(100)
  value String @db.Text
}

// ----------------------------------------------------
// Identity & Security (IAM) Models
// ----------------------------------------------------

model User {
  id             String     @id @default(uuid()) @db.Char(36)
  email          String     @unique @db.VarChar(255)
  firstName      String     @db.VarChar(100)
  lastName       String     @db.VarChar(100)
  password       String     @db.VarChar(255)
  avatarUrl      String?    @db.VarChar(255)
  status         UserStatus @default(PENDING)
  
  // Relations
  roleId         String?    @db.Char(36)
  role           Role?      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  
  departmentId   String?    @db.Char(36)
  department     Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: Restrict)
  
  designationId  String?    @db.Char(36)
  designation    Designation? @relation(fields: [designationId], references: [id], onDelete: Restrict)
  
  preferences    UserPreference?
  teams          UserTeam[]
  
  // Head/Lead Back-relations
  managedDepartments Department[] @relation("DepartmentManager")
  deputyDepartments  Department[] @relation("DepartmentDeputy")
  ledTeams           Team[]       @relation("TeamLead")

  // CRM Module Relations
  ownedLeads            Lead[]               @relation("LeadOwner")
  assignedLeads         LeadAssignment[]     @relation("LeadAssignee")
  createdAssignments    LeadAssignment[]     @relation("LeadAssigner")
  transferredAssignments LeadAssignment[]    @relation("LeadTransferrer")
  proposalsApproved     ProposalApproval[]   @relation("ProposalApprover")
  proposalVersionsCreated ProposalVersion[]  @relation("ProposalVersionCreator")
  ownedOpportunities    Opportunity[]        @relation("OpportunityOwner")
  proposalPDFsGenerated Proposal[]           @relation("ProposalPDFGenerator")
  
  // Project Module Relations
  managedProjects      Project[]            @relation("ProjectManager")
  projectMemberships   ProjectMember[]
  resourceAllocations  ProjectResource[]
  assignedMilestones   ProjectMilestone[]   @relation("MilestoneOwner")
  assignedIssues       ProjectIssue[]       @relation("IssueAssignee")
  ownedRisks           ProjectRisk[]        @relation("RiskOwner")

  // Task Module Relations
  assignedTasks        Task[]               @relation("TaskAssignees")
  watchedTasks         TaskWatcher[]        @relation("TaskWatcherUser")
  taskComments         TaskComment[]        @relation("TaskCommentAuthor")
  uploadedAttachments  TaskAttachment[]     @relation("TaskAttachmentUploader")

  // Authentication & Security Additions
  failedLoginAttempts   Int                  @default(0)
  lockedUntil           DateTime?            @db.Timestamp
  lastLoginAt           DateTime?            @db.Timestamp
  lastPasswordChangedAt DateTime?            @db.Timestamp
  emailVerifiedAt       DateTime?            @db.Timestamp
  emailVerificationToken String?             @db.VarChar(255)
  mfaEnabled            Boolean              @default(false)
  mfaSecret             String?              @db.VarChar(255)
  backupCodes           Json?

  sessions              UserSession[]
  passwordHistories     PasswordHistory[]
  passwordResetTokens   PasswordResetToken[]

  // Sprint 8 Productivity Relations
  workSessions          WorkSession[]
  taskTimers            TaskTimer[]
  timeEntries           TimeEntry[]
  timesheetApprovals    TimesheetApproval[]  @relation("TimesheetApprover")
  dailyTimesheets       DailyTimesheet[]
  weeklyTimesheets      WeeklyTimesheet[]
  productivityScores    ProductivityScore[]
  utilizationReports    UtilizationReport[]

  // Sprint 9 Finance Relations
  expenses              Expense[]
  billableRates         BillableRate[]

  // Sprint 10 HR Relations
  employeeProfile       EmployeeProfile?
  leaveApprovals        LeaveApproval[]      @relation("LeaveRequestApprover")
  managerPerformanceReviews PerformanceReview[] @relation("PerformanceManagerReviewer")
  deploymentsStarted        Deployment[]        @relation("UserDeployments")

  // Sprint 12 Reports & BI Relations
  dashboards            Dashboard[]
  dashboardShares       DashboardShare[]
  scheduledReports      ScheduledReport[]
  reportExecutions      ReportExecution[]
  reportExports         ReportExport[]
  savedFilters          SavedFilter[]
  reportVersions        ReportVersion[]      @relation("UserReportVersions")
  reportFavorites       ReportFavorite[]
  recentReports         RecentlyOpenedReport[]

  // Sprint 13 Notifications & Workflows Relations
  notifications         Notification[]       @relation("UserNotification")
  notificationPreferences NotificationPreference[]
  announcements         Announcement[]       @relation("AnnouncementCreator")
  approvalRequests      ApprovalRequest[]    @relation("ApproverUser")
  workflowExecutions    WorkflowExecution[]
  communicationLogs     CommunicationLog[]

  // Sprint 14 SEO Relations
  seoProjects           SEOProject[]         @relation("UserSeoProjects")
  seoReports            SEOReport[]

  // Sprint 15 API Gateway & Integrations Relations
  apiKeys               ApiKey[]
  oauthApplications     OAuthApplication[]
  developerApplications DeveloperApplication[]
  webhooks              Webhook[]
  apiLogs               ApiLog[]

  // Audit Fields
  createdAt      DateTime   @default(now()) @db.Timestamp
  updatedAt      DateTime   @updatedAt @db.Timestamp
  deletedAt      DateTime?  @db.Timestamp
  createdBy      String?    @db.Char(36)
  updatedBy      String?    @db.Char(36)
  deletedBy      String?    @db.Char(36)
  version        Int        @default(0)

  @@index([status])
  @@map("users")
}

model UserPreference {
  id                  String    @id @default(uuid()) @db.Char(36)
  userId              String    @unique @db.Char(36)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme               String    @default("light") @db.VarChar(20)
  language            String    @default("en") @db.VarChar(10)
  timezone            String    @default("Asia/Kolkata") @db.VarChar(50)
  notificationsEnabled Boolean   @default(true)

  // Audit Fields
  createdAt      DateTime   @default(now()) @db.Timestamp
  updatedAt      DateTime   @updatedAt @db.Timestamp
  deletedAt      DateTime?  @db.Timestamp
  createdBy      String?    @db.Char(36)
  updatedBy      String?    @db.Char(36)
  deletedBy      String?    @db.Char(36)
  version        Int        @default(0)

  @@map("user_preferences")
}

model Role {
  id             String    @id @default(uuid()) @db.Char(36)
  name           String    @unique @db.VarChar(100)
  description    String?   @db.VarChar(255)
  isSystem       Boolean   @default(false)
  
  // Hierarchy self-relation
  parentId       String?   @db.Char(36)
  parent         Role?     @relation("RoleHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       Role[]    @relation("RoleHierarchy")
  
  // Relations
  users          User[]
  permissions    Permission[] @relation("RolePermissions")
  dashboardShares DashboardShare[]
  notificationPreferences NotificationPreference[]

  // Audit Fields
  createdAt      DateTime   @default(now()) @db.Timestamp
  updatedAt      DateTime   @updatedAt @db.Timestamp
  deletedAt      DateTime?  @db.Timestamp
  createdBy      String?    @db.Char(36)
  updatedBy      String?    @db.Char(36)
  deletedBy      String?    @db.Char(36)
  version        Int        @default(0)

  @@map("roles")
}

model PermissionGroup {
  id             String               @id @default(uuid()) @db.Char(36)
  name           String               @unique @db.VarChar(100)
  description    String?              @db.VarChar(255)
  categories     PermissionCategory[]

  // Audit Fields
  createdAt      DateTime   @default(now()) @db.Timestamp
  updatedAt      DateTime   @updatedAt @db.Timestamp
  deletedAt      DateTime?  @db.Timestamp
  createdBy      String?    @db.Char(36)
  updatedBy      String?    @db.Char(36)
  deletedBy      String?    @db.Char(36)
  version        Int        @default(0)

  @@map("permission_groups")
}

model PermissionCategory {
  id             String          @id @default(uuid()) @db.Char(36)
  name           String          @unique @db.VarChar(100)
  description    String?         @db.VarChar(255)
  
  // Relations
  groupId        String          @db.Char(36)
  group          PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permissions    Permission[]

  // Audit Fields
  createdAt      DateTime   @default(now()) @db.Timestamp
  updatedAt      DateTime   @updatedAt @db.Timestamp
  deletedAt      DateTime?  @db.Timestamp
  createdBy      String?    @db.Char(36)
  updatedBy      String?    @db.Char(36)
  deletedBy      String?    @db.Char(36)
  version        Int        @default(0)

  @@map("permission_categories")
}

model Permission {
  id             String             @id @default(uuid()) @db.Char(36)
  name           String             @unique @db.VarChar(100)
  code           String             @unique @db.VarChar(100) // e.g. "users.create"
  
  // Relations
  categoryId     String             @db.Char(36)
  category       PermissionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  roles          Role[]             @relation("RolePermissions")

  // Audit Fields
  createdAt      DateTime   @default(now()) @db.Timestamp
  updatedAt      DateTime   @updatedAt @db.Timestamp
  deletedAt      DateTime?  @db.Timestamp
  createdBy      String?    @db.Char(36)
  updatedBy      String?    @db.Char(36)
  deletedBy      String?    @db.Char(36)
  version        Int        @default(0)

  @@map("permissions")
}

model Department {
  id              String       @id @default(uuid()) @db.Char(36)
  name            String       @unique @db.VarChar(100)
  code            String       @unique @db.VarChar(50)
  displayOrder    Int          @default(0)
  isRoot          Boolean      @default(false)
  status          Status       @default(ACTIVE)

  // Hierarchy self-relation
  parentId        String?      @db.Char(36)
  parent          Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        Department[] @relation("DepartmentHierarchy")

  // Relations
  managerId       String?      @db.Char(36)
  manager         User?        @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: Restrict)
  deputyManagerId String?      @db.Char(36)
  deputyManager   User?        @relation("DepartmentDeputy", fields: [deputyManagerId], references: [id], onDelete: Restrict)
  
  users           User[]       @relation("DepartmentMembers")
  designations    Designation[]
  savedFilters    SavedFilter[]
  announcements   Announcement[] @relation("DepartmentAnnouncements")

  // Audit Fields
  createdAt      DateTime   @default(now()) @db.Timestamp
  updatedAt      DateTime   @updatedAt @db.Timestamp
  deletedAt      DateTime?  @db.Timestamp
  createdBy      String?    @db.Char(36)
  updatedBy      String?    @db.Char(36)
  deletedBy      String?    @db.Char(36)
  version        Int        @default(0)

  @@map("departments")
}

model Team {
  id             String     @id @default(uuid()) @db.Char(36)
  name           String     @unique @db.VarChar(100)
  code           String     @unique @db.VarChar(50)
  description    String?    @db.VarChar(255)
  status         Status     @default(ACTIVE)

  // Relations
  leadId         String?    @db.Char(36)
  lead           User?      @relation("TeamLead", fields: [leadId], references: [id], onDelete: Restrict)
  members        UserTeam[]

  // Audit Fields
  createdAt      DateTime   @default(now()) @db.Timestamp
  updatedAt      DateTime   @updatedAt @db.Timestamp
  deletedAt      DateTime?  @db.Timestamp
  createdBy      String?    @db.Char(36)
  updatedBy      String?    @db.Char(36)
  deletedBy      String?    @db.Char(36)
  version        Int        @default(0)

  @@map("teams")
}

model UserTeam {
  userId     String   @db.Char(36)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId     String   @db.Char(36)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  roleInTeam String   @default("member") @db.VarChar(50)

  // Audit Fields
  createdAt  DateTime @default(now()) @db.Timestamp
  updatedAt  DateTime @updatedAt @db.Timestamp

  @@id([userId, teamId])
  @@map("user_teams")
}

model Designation {
  id             String      @id @default(uuid()) @db.Char(36)
  name           String      @unique @db.VarChar(100)
  code           String      @unique @db.VarChar(50)
  description    String?     @db.VarChar(255)
  sortOrder      Int         @default(0)
  status         Status      @default(ACTIVE)
  
  // Relations
  departmentId   String?     @db.Char(36)
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  users          User[]

  // Audit Fields
  createdAt      DateTime   @default(now()) @db.Timestamp
  updatedAt      DateTime   @updatedAt @db.Timestamp
  deletedAt      DateTime?  @db.Timestamp
  createdBy      String?    @db.Char(36)
  updatedBy      String?    @db.Char(36)
  deletedBy      String?    @db.Char(36)
  version        Int        @default(0)

  @@map("designations")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String    @db.Char(36)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @db.VarChar(255)
  deviceName       String?   @db.VarChar(100)
  deviceType       String?   @db.VarChar(50)
  browser          String?   @db.VarChar(100)
  operatingSystem  String?   @db.VarChar(100)
  ipAddress        String?   @db.VarChar(50)
  userAgent        String?   @db.VarChar(255)
  lastActivityAt   DateTime  @default(now()) @db.Timestamp
  revokedAt        DateTime? @db.Timestamp
  expiresAt        DateTime  @db.Timestamp
  createdAt        DateTime  @default(now()) @db.Timestamp
  updatedAt        DateTime  @updatedAt @db.Timestamp

  @@index([userId])
  @@map("user_sessions")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Char(36)
  userId       String   @db.Char(36)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now()) @db.Timestamp

  @@index([userId])
  @@map("password_histories")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime  @db.Timestamp
  usedAt    DateTime? @db.Timestamp
  createdAt DateTime  @default(now()) @db.Timestamp

  @@index([userId])
  @@map("password_reset_tokens")
}

// ----------------------------------------------------
// Client Management Module (Sprint 4) Models
// ----------------------------------------------------

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  ON_HOLD
  ARCHIVED
}

enum AddressType {
  BILLING
  SHIPPING
  HEAD_OFFICE
  BRANCH_OFFICE
  OTHER
}

enum DocumentCategory {
  CONTRACT
  NDA
  PURCHASE_ORDER
  INVOICE
  CERTIFICATE
  LICENSE
  OTHER
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

enum NoteType {
  INTERNAL
  FOLLOW_UP
}

model ClientCategory {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @unique @db.VarChar(100)
  code        String    @unique @db.VarChar(50)
  description String?   @db.VarChar(255)
  isSystem    Boolean   @default(false)
  
  // Relations
  clients     Client[]

  // Audit Fields
  createdAt   DateTime  @default(now()) @db.Timestamp
  updatedAt   DateTime  @updatedAt @db.Timestamp
  deletedAt   DateTime? @db.Timestamp
  createdBy   String?   @db.Char(36)
  updatedBy   String?   @db.Char(36)
  deletedBy   String?   @db.Char(36)
  version     Int       @default(0)

  @@map("client_categories")
}

model Client {
  id                 String           @id @default(uuid()) @db.Char(36)
  name               String           @db.VarChar(255)
  code               String           @unique @db.VarChar(100)
  status             ClientStatus     @default(PROSPECT)
  industry           String?          @db.VarChar(100)
  companyType        String?          @db.VarChar(100)
  website            String?          @db.VarChar(255)
  gstVatNumber       String?          @db.VarChar(50)
  taxNumber          String?          @db.VarChar(50)
  registrationNumber String?          @db.VarChar(100)
  profileLogo        String?          @db.VarChar(255)
  remarks            String?          @db.Text
  
  // Relations
  categoryId         String           @db.Char(36)
  category           ClientCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  
  contacts           ClientContact[]  @relation("ClientToContacts")
  addresses          ClientAddress[]  @relation("ClientToAddresses")
  documents          ClientDocument[]
  contracts          ClientContract[]
  notes              ClientNote[]
  timelines          ClientTimeline[]
  tags               ClientTag[]      @relation("ClientToTags")
  opportunities      Opportunity[]
  projects           Project[]
  invoices           Invoice[]
  recurringInvoices  RecurringInvoice[]
  estimates          Estimate[]
  billableRates      BillableRate[]
  hostingAccounts    HostingAccount[]
  servers            Server[]
  domains            Domain[]
  seoProjects        SEOProject[]
  integrations       Integration[]

  primaryContactId   String?          @db.Char(36)
  primaryContact     ClientContact?   @relation("PrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)

  primaryAddressId   String?          @db.Char(36)
  primaryAddress     ClientAddress?   @relation("PrimaryAddress", fields: [primaryAddressId], references: [id], onDelete: SetNull)

  // Audit Fields
  createdAt          DateTime         @default(now()) @db.Timestamp
  updatedAt          DateTime         @updatedAt @db.Timestamp
  deletedAt          DateTime?        @db.Timestamp
  createdBy          String?          @db.Char(36)
  updatedBy          String?          @db.Char(36)
  deletedBy          String?          @db.Char(36)
  version            Int              @default(0)

  @@index([status])
  @@index([categoryId])
  @@map("clients")
}

model ClientContact {
  id                     String    @id @default(uuid()) @db.Char(36)
  clientId               String    @db.Char(36)
  client                 Client    @relation("ClientToContacts", fields: [clientId], references: [id], onDelete: Cascade)
  
  name                   String    @db.VarChar(255)
  designation            String?   @db.VarChar(100)
  email                  String    @db.VarChar(255)
  mobile                 String?   @db.VarChar(50)
  officePhone            String?   @db.VarChar(50)
  whatsApp               String?   @db.VarChar(50)
  birthday               DateTime? @db.Date
  notes                  String?   @db.Text
  status                 Status    @default(ACTIVE)
  isPrimary              Boolean   @default(false)
  
  linkedIn               String?   @db.VarChar(255)
  preferredContactMethod String?   @db.VarChar(50)
  preferredContactTime   String?   @db.VarChar(100)

  // Back-relation for Client.primaryContact
  primaryForClients      Client[]  @relation("PrimaryContact")

  // Audit Fields
  createdAt              DateTime  @default(now()) @db.Timestamp
  updatedAt              DateTime  @updatedAt @db.Timestamp
  deletedAt              DateTime? @db.Timestamp
  createdBy              String?   @db.Char(36)
  updatedBy              String?   @db.Char(36)
  deletedBy              String?   @db.Char(36)
  version                Int       @default(0)

  @@index([clientId])
  @@index([email])
  @@map("client_contacts")
}

model ClientAddress {
  id                String      @id @default(uuid()) @db.Char(36)
  clientId          String      @db.Char(36)
  client            Client      @relation("ClientToAddresses", fields: [clientId], references: [id], onDelete: Cascade)
  
  type              AddressType @default(BILLING)
  addressLine1      String      @db.VarChar(255)
  addressLine2      String?     @db.VarChar(255)
  city              String      @db.VarChar(100)
  state             String?     @db.VarChar(100)
  postalCode        String      @db.VarChar(20)
  country           String      @db.VarChar(100)
  isPrimary         Boolean     @default(false)
  
  latitude          Decimal?    @db.Decimal(10, 8)
  longitude         Decimal?    @db.Decimal(11, 8)
  googleMapsUrl     String?     @db.VarChar(512)

  // Back-relation for Client.primaryAddress
  primaryForClients Client[]    @relation("PrimaryAddress")

  // Audit Fields
  createdAt         DateTime    @default(now()) @db.Timestamp
  updatedAt         DateTime    @updatedAt @db.Timestamp
  deletedAt         DateTime?   @db.Timestamp
  createdBy         String?     @db.Char(36)
  updatedBy         String?     @db.Char(36)
  deletedBy         String?     @db.Char(36)
  version           Int         @default(0)

  @@index([clientId])
  @@map("client_addresses")
}

model ClientDocument {
  id           String           @id @default(uuid()) @db.Char(36)
  clientId     String           @db.Char(36)
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  fileName     String           @db.VarChar(255)
  fileKey      String           @db.VarChar(255)
  mimeType     String?          @db.VarChar(100)
  fileSize     Int?
  documentVersion String           @default("1.0") @db.VarChar(20)
  category     DocumentCategory @default(OTHER)
  
  expiryDate   DateTime?        @db.Date
  reminderDate DateTime?        @db.Date
  uploadDate   DateTime         @default(now()) @db.Timestamp
  uploadedBy   String           @db.Char(36)

  // Audit Fields
  createdAt    DateTime         @default(now()) @db.Timestamp
  updatedAt    DateTime         @updatedAt @db.Timestamp
  deletedAt    DateTime?        @db.Timestamp
  createdBy    String?          @db.Char(36)
  updatedBy    String?          @db.Char(36)
  deletedBy    String?          @db.Char(36)
  version      Int              @default(0)

  @@index([clientId])
  @@map("client_documents")
}

model ClientContract {
  id                String         @id @default(uuid()) @db.Char(36)
  clientId          String         @db.Char(36)
  client            Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  contractNumber    String         @unique @db.VarChar(100)
  startDate         DateTime       @db.Date
  endDate           DateTime       @db.Date
  renewalDate       DateTime?      @db.Date
  status            ContractStatus @default(DRAFT)
  renewalReminder   Boolean        @default(false)
  documentReference String?        @db.VarChar(255)
  
  contractValue     Decimal?       @db.Decimal(15, 2)
  currency          String?        @db.VarChar(10) @default("INR")
  autoRenewal       Boolean        @default(false)
  noticePeriod      Int?
  renewalOwnerId    String?        @db.Char(36)

  // Audit Fields
  createdAt         DateTime       @default(now()) @db.Timestamp
  updatedAt         DateTime       @updatedAt @db.Timestamp
  deletedAt         DateTime?      @db.Timestamp
  createdBy         String?        @db.Char(36)
  updatedBy         String?        @db.Char(36)
  deletedBy         String?        @db.Char(36)
  version           Int            @default(0)

  @@index([clientId])
  @@map("client_contracts")
}

model ClientNote {
  id                   String    @id @default(uuid()) @db.Char(36)
  clientId             String    @db.Char(36)
  client               Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  title                String?   @db.VarChar(255)
  content              String    @db.Text
  type                 NoteType  @default(INTERNAL)
  attachmentsReference Json?
  
  pinned               Boolean   @default(false)
  private              Boolean   @default(false)
  mentions             Json?

  // Audit Fields
  createdAt            DateTime  @default(now()) @db.Timestamp
  updatedAt            DateTime  @updatedAt @db.Timestamp
  deletedAt            DateTime? @db.Timestamp
  createdBy            String?   @db.Char(36)
  updatedBy            String?   @db.Char(36)
  deletedBy            String?   @db.Char(36)
  version              Int       @default(0)

  @@index([clientId])
  @@map("client_notes")
}

model ClientTag {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @unique @db.VarChar(100)
  clients   Client[] @relation("ClientToTags")

  // Audit Fields
  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @updatedAt @db.Timestamp

  @@map("client_tags")
}

model ClientTimeline {
  id          String   @id @default(uuid()) @db.Char(36)
  clientId    String   @db.Char(36)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  event       String   @db.VarChar(100)
  description String   @db.Text
  metadata    Json?
  
  createdAt   DateTime @default(now()) @db.Timestamp
  createdBy   String?  @db.Char(36)

  @@index([clientId])
  @@map("client_timelines")
}

// ====================================================
// Enterprise CRM Module (Sprint 5)
// ====================================================

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum LeadTemperature {
  COLD
  WARM
  HOT
}

enum LeadActivityType {
  PHONE_CALL
  MEETING
  EMAIL
  WHATSAPP
  SMS
  TASK
  REMINDER
  NOTE
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeadSource {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @unique @db.VarChar(100)
  code        String    @unique @db.VarChar(50)
  description String?   @db.VarChar(255)
  isSystem    Boolean   @default(false)
  leads       Lead[]

  // Audit Fields
  createdAt   DateTime  @default(now()) @db.Timestamp
  updatedAt   DateTime  @updatedAt @db.Timestamp
  deletedAt   DateTime? @db.Timestamp
  createdBy   String?   @db.Char(36)
  updatedBy   String?   @db.Char(36)
  deletedBy   String?   @db.Char(36)
  version     Int       @default(0)

  @@map("lead_sources")
}

model LeadStatus {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @unique @db.VarChar(100)
  code        String    @unique @db.VarChar(50)
  description String?   @db.VarChar(255)
  isSystem    Boolean   @default(false)
  leads       Lead[]

  // Audit Fields
  createdAt   DateTime  @default(now()) @db.Timestamp
  updatedAt   DateTime  @updatedAt @db.Timestamp
  deletedAt   DateTime? @db.Timestamp
  createdBy   String?   @db.Char(36)
  updatedBy   String?   @db.Char(36)
  deletedBy   String?   @db.Char(36)
  version     Int       @default(0)

  @@map("lead_statuses")
}

model Lead {
  id                  String           @id @default(uuid()) @db.Char(36)
  companyName         String           @db.VarChar(255)
  contactName         String           @db.VarChar(255)
  email               String           @db.VarChar(255)
  phone               String?          @db.VarChar(50)
  website             String?          @db.VarChar(255)
  gstNumber           String?          @db.VarChar(50)
  expectedBudget      Decimal?         @db.Decimal(15, 2)
  expectedClosingDate DateTime?        @db.Date
  remarks             String?          @db.Text
  leadScore           Int              @default(0)
  leadPriority        LeadPriority     @default(MEDIUM)
  leadTemperature     LeadTemperature  @default(WARM)
  
  // Relations
  sourceId            String           @db.Char(36)
  source              LeadSource       @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  statusId            String           @db.Char(36)
  status              LeadStatus       @relation(fields: [statusId], references: [id], onDelete: Restrict)
  ownerId             String           @db.Char(36)
  owner               User             @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  activities          LeadActivity[]
  assignments         LeadAssignment[]
  timelines           LeadTimeline[]
  opportunities       Opportunity[]

  // Audit Fields
  createdAt           DateTime         @default(now()) @db.Timestamp
  updatedAt           DateTime         @updatedAt @db.Timestamp
  deletedAt           DateTime?        @db.Timestamp
  createdBy           String?          @db.Char(36)
  updatedBy           String?          @db.Char(36)
  deletedBy           String?          @db.Char(36)
  version             Int              @default(0)

  @@index([statusId])
  @@index([sourceId])
  @@index([ownerId])
  @@map("leads")
}

model LeadActivity {
  id           String           @id @default(uuid()) @db.Char(36)
  leadId       String           @db.Char(36)
  lead         Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type         LeadActivityType @default(NOTE)
  title        String           @db.VarChar(255)
  description  String?          @db.Text
  activityDate DateTime         @default(now()) @db.Timestamp
  createdBy    String           @db.Char(36)

  // Audit Fields
  createdAt    DateTime         @default(now()) @db.Timestamp
  updatedAt    DateTime         @updatedAt @db.Timestamp
  deletedAt    DateTime?        @db.Timestamp
  updatedBy    String?          @db.Char(36)
  deletedBy    String?          @db.Char(36)
  version      Int              @default(0)

  @@index([leadId])
  @@map("lead_activities")
}

model LeadAssignment {
  id             String    @id @default(uuid()) @db.Char(36)
  leadId         String    @db.Char(36)
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  assigneeId     String    @db.Char(36)
  assignee       User      @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  
  assignedById   String    @db.Char(36)
  assignedBy     User      @relation("LeadAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  
  assignedAt     DateTime  @default(now()) @db.Timestamp
  notes          String?   @db.Text
  
  transferFromId String?   @db.Char(36)
  transferFrom   User?     @relation("LeadTransferrer", fields: [transferFromId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([assigneeId])
  @@map("lead_assignments")
}

model LeadTimeline {
  id          String   @id @default(uuid()) @db.Char(36)
  leadId      String   @db.Char(36)
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  event       String   @db.VarChar(100)
  description String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamp
  createdBy   String?  @db.Char(36)

  @@index([leadId])
  @@map("lead_timelines")
}

model Pipeline {
  id          String          @id @default(uuid()) @db.Char(36)
  name        String          @unique @db.VarChar(100)
  description String?         @db.VarChar(255)
  stages      PipelineStage[]

  // Audit Fields
  createdAt   DateTime        @default(now()) @db.Timestamp
  updatedAt   DateTime        @updatedAt @db.Timestamp
  deletedAt   DateTime?       @db.Timestamp
  createdBy   String?         @db.Char(36)
  updatedBy   String?         @db.Char(36)
  deletedBy   String?         @db.Char(36)
  version     Int             @default(0)

  @@map("pipelines")
}

model PipelineStage {
  id            String        @id @default(uuid()) @db.Char(36)
  pipelineId    String        @db.Char(36)
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name          String        @db.VarChar(100)
  code          String        @db.VarChar(50)
  probability   Int           @default(10)
  sortOrder     Int           @default(0)
  opportunities Opportunity[]

  // Audit Fields
  createdAt     DateTime      @default(now()) @db.Timestamp
  updatedAt     DateTime      @updatedAt @db.Timestamp
  deletedAt     DateTime?     @db.Timestamp
  createdBy     String?       @db.Char(36)
  updatedBy     String?       @db.Char(36)
  deletedBy     String?       @db.Char(36)
  version       Int           @default(0)

  @@unique([pipelineId, code])
  @@map("pipeline_stages")
}

model Opportunity {
  id                String                @id @default(uuid()) @db.Char(36)
  leadId            String?               @db.Char(36)
  lead              Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  name              String                @db.VarChar(255)
  value             Decimal               @db.Decimal(15, 2)
  probability       Int                   @default(10)
  expectedCloseDate DateTime              @db.Date
  
  stageId           String                @db.Char(36)
  stage             PipelineStage         @relation(fields: [stageId], references: [id], onDelete: Restrict)
  
  competitors       String?               @db.Text
  winReason         String?               @db.Text
  lossReason        String?               @db.Text
  
  ownerId           String                @db.Char(36)
  owner             User                  @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  
  clientId          String?               @db.Char(36)
  client            Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)

  items             OpportunityItem[]
  timelines         OpportunityTimeline[]
  proposals         Proposal[]

  // Audit Fields
  createdAt         DateTime              @default(now()) @db.Timestamp
  updatedAt         DateTime              @updatedAt @db.Timestamp
  deletedAt         DateTime?             @db.Timestamp
  createdBy         String?               @db.Char(36)
  updatedBy         String?               @db.Char(36)
  deletedBy         String?               @db.Char(36)
  version           Int                   @default(0)

  @@index([stageId])
  @@index([ownerId])
  @@index([clientId])
  @@map("opportunities")
}

model OpportunityItem {
  id            String      @id @default(uuid()) @db.Char(36)
  opportunityId String      @db.Char(36)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  productName   String      @db.VarChar(255)
  quantity      Int         @default(1)
  price         Decimal     @db.Decimal(15, 2)
  discount      Decimal     @default(0.00) @db.Decimal(15, 2)
  tax           Decimal     @default(0.00) @db.Decimal(5, 2)
  total         Decimal     @db.Decimal(15, 2)

  // Audit Fields
  createdAt     DateTime    @default(now()) @db.Timestamp
  updatedAt     DateTime    @updatedAt @db.Timestamp
  createdBy     String?     @db.Char(36)
  updatedBy     String?     @db.Char(36)

  @@index([opportunityId])
  @@map("opportunity_items")
}

model OpportunityTimeline {
  id            String      @id @default(uuid()) @db.Char(36)
  opportunityId String      @db.Char(36)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  event         String      @db.VarChar(100)
  description   String      @db.Text
  metadata      Json?
  createdAt     DateTime    @default(now()) @db.Timestamp
  createdBy     String?     @db.Char(36)

  @@index([opportunityId])
  @@map("opportunity_timelines")
}

model ProposalTemplate {
  id        String     @id @default(uuid()) @db.Char(36)
  name      String     @unique @db.VarChar(255)
  subject   String     @db.VarChar(255)
  content   String     @db.Text
  proposals Proposal[]

  // Audit Fields
  createdAt DateTime   @default(now()) @db.Timestamp
  updatedAt DateTime   @updatedAt @db.Timestamp
  deletedAt DateTime?  @db.Timestamp
  createdBy String?    @db.Char(36)
  updatedBy String?    @db.Char(36)
  deletedBy String?    @db.Char(36)
  version   Int        @default(0)

  @@map("proposal_templates")
}

model Proposal {
  id             String             @id @default(uuid()) @db.Char(36)
  opportunityId  String             @db.Char(36)
  opportunity    Opportunity        @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  title          String             @db.VarChar(255)
  proposalNumber String             @unique @db.VarChar(100)
  status         ProposalStatus     @default(DRAFT)
  
  subtotal       Decimal            @default(0.00) @db.Decimal(15, 2)
  discountTotal  Decimal            @default(0.00) @db.Decimal(15, 2)
  taxTotal       Decimal            @default(0.00) @db.Decimal(15, 2)
  total          Decimal            @default(0.00) @db.Decimal(15, 2)
  
  currency       String             @default("INR") @db.VarChar(10)
  validUntil     DateTime           @db.Date
  templateId     String?            @db.Char(36)
  template       ProposalTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  
  pdfFileKey     String?            @db.VarChar(255)
  currentVersion Int                @default(1)

  // PDF Metadata
  pdfGeneratedAt DateTime?          @db.Timestamp
  pdfGeneratedBy String?            @db.Char(36)
  pdfGenerator   User?              @relation("ProposalPDFGenerator", fields: [pdfGeneratedBy], references: [id], onDelete: SetNull)
  pdfVersion     Int?
  pdfFileSize    Int?
  pdfChecksum    String?            @db.VarChar(255)

  items          ProposalItem[]
  versions       ProposalVersion[]
  approvals      ProposalApproval[]
  projects       Project[]

  // Audit Fields
  createdAt      DateTime           @default(now()) @db.Timestamp
  updatedAt      DateTime           @updatedAt @db.Timestamp
  deletedAt      DateTime?          @db.Timestamp
  createdBy      String?            @db.Char(36)
  updatedBy      String?            @db.Char(36)
  deletedBy      String?            @db.Char(36)
  version        Int                @default(0)

  @@index([opportunityId])
  @@map("proposals")
}

model ProposalItem {
  id          String   @id @default(uuid()) @db.Char(36)
  proposalId  String   @db.Char(36)
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  productName String   @db.VarChar(255)
  quantity    Int      @default(1)
  price       Decimal  @db.Decimal(15, 2)
  discount    Decimal  @default(0.00) @db.Decimal(15, 2)
  tax         Decimal  @default(0.00) @db.Decimal(5, 2)
  total       Decimal  @db.Decimal(15, 2)

  // Audit Fields
  createdAt   DateTime @default(now()) @db.Timestamp
  updatedAt   DateTime @updatedAt @db.Timestamp

  @@index([proposalId])
  @@map("proposal_items")
}

model ProposalVersion {
  id            String   @id @default(uuid()) @db.Char(36)
  proposalId    String   @db.Char(36)
  proposal      Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  versionNumber Int
  title         String   @db.VarChar(255)
  subtotal      Decimal  @default(0.00) @db.Decimal(15, 2)
  discountTotal Decimal  @default(0.00) @db.Decimal(15, 2)
  taxTotal      Decimal  @default(0.00) @db.Decimal(15, 2)
  total         Decimal  @default(0.00) @db.Decimal(15, 2)
  content       String   @db.Text
  pdfFileKey    String?  @db.VarChar(255)
  
  createdAt     DateTime @default(now()) @db.Timestamp
  createdBy     String   @db.Char(36)
  creator       User     @relation("ProposalVersionCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([proposalId])
  @@map("proposal_versions")
}

model ProposalApproval {
  id         String         @id @default(uuid()) @db.Char(36)
  proposalId String         @db.Char(36)
  proposal   Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  
  approverId String         @db.Char(36)
  approver   User           @relation("ProposalApprover", fields: [approverId], references: [id], onDelete: Restrict)
  
  status     ApprovalStatus @default(PENDING)
  comments   String?        @db.Text
  level      Int            @default(1)
  reviewedAt DateTime?      @db.Timestamp
  createdAt  DateTime       @default(now()) @db.Timestamp

  @@index([proposalId])
  @@map("proposal_approvals")
}

// ====================================================
// Enterprise Project Management Module (Sprint 6)
// ====================================================

enum ProjectType {
  FIXED_PRICE
  TIME_AND_MATERIAL
  RETAINER
  MAINTENANCE
  INTERNAL
  RD
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectHealth {
  GREEN
  AMBER
  RED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum DependencyType {
  FS
  SS
  FF
  SF
}

enum RiskProbability {
  LOW
  MEDIUM
  HIGH
}

enum RiskImpact {
  LOW
  MEDIUM
  HIGH
}

enum RiskStatus {
  IDENTIFIED
  MITIGATED
  OCCURRED
  CLOSED
}

enum IssueType {
  BUG
  CHANGE_REQUEST
  BLOCKER
  DEPENDENCY
  CLIENT_ISSUE
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ProjectDocumentCategory {
  REQUIREMENTS
  DESIGN
  CONTRACT
  WIREFRAME
  MEETING_NOTES
  DEPLOYMENT
  OTHER
}

model ProjectCategory {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @unique @db.VarChar(100)
  code        String    @unique @db.VarChar(50)
  description String?   @db.VarChar(255)
  projects    Project[]

  // Audit Fields
  createdAt   DateTime  @default(now()) @db.Timestamp
  updatedAt   DateTime  @updatedAt @db.Timestamp
  deletedAt   DateTime? @db.Timestamp
  createdBy   String?   @db.Char(36)
  updatedBy   String?   @db.Char(36)
  deletedBy   String?   @db.Char(36)
  version     Int       @default(0)

  @@map("project_categories")
}

model Project {
  id                   String            @id @default(uuid()) @db.Char(36)
  code                 String            @unique @db.VarChar(100)
  name                 String            @db.VarChar(255)
  description          String?           @db.Text
  type                 ProjectType       @default(FIXED_PRICE)
  priority             ProjectPriority   @default(MEDIUM)
  status               ProjectStatus     @default(PLANNING)
  healthStatus         ProjectHealth     @default(GREEN)
  
  estimatedCost        Decimal           @default(0.00) @db.Decimal(15, 2)
  actualCost           Decimal           @default(0.00) @db.Decimal(15, 2)
  remainingBudget      Decimal           @default(0.00) @db.Decimal(15, 2)
  budgetVariance       Decimal           @default(0.00) @db.Decimal(15, 2)
  estimatedRevenue     Decimal           @default(0.00) @db.Decimal(15, 2)
  estimatedHours       Decimal           @default(0.00) @db.Decimal(10, 2)
  
  startDate            DateTime          @db.Date
  endDate              DateTime          @db.Date
  actualStartDate      DateTime?         @db.Date
  actualEndDate        DateTime?         @db.Date
  completionPercentage Int               @default(0)
  colorLabel           String?           @db.VarChar(50)
  
  // Relations
  categoryId           String            @db.Char(36)
  category             ProjectCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  
  clientId             String?           @db.Char(36)
  client               Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  proposalId           String?           @db.Char(36)
  proposal             Proposal?         @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  
  managerId            String            @db.Char(36)
  manager              User              @relation("ProjectManager", fields: [managerId], references: [id], onDelete: Restrict)

  tags                 ProjectTag[]      @relation("ProjectToTags")
  phases               ProjectPhase[]
  milestones           ProjectMilestone[]
  members              ProjectMember[]
  resources            ProjectResource[]
  risks                ProjectRisk[]
  issues               ProjectIssue[]
  documents            ProjectDocument[]
  timelines            ProjectTimeline[]
  tasks                Task[]
  sprints              Sprint[]
  timeEntries          TimeEntry[]
  utilizationReports   UtilizationReport[]
  invoices             Invoice[]
  expenses             Expense[]
  recurringInvoices    RecurringInvoice[]
  billableRates        BillableRate[]
  projectBilling       ProjectBilling[]
  hostingAccounts      HostingAccount[]
  servers              Server[]
  serverEnvironments   ServerEnvironment[]
  deployments          Deployment[]
  repositories         Repository[]
  domains              Domain[]
  seoProjects          SEOProject[]
  integrations         Integration[]
  webhooks             Webhook[]

  dependencies         ProjectDependency[] @relation("ProjectDependencies")
  dependentProjects    ProjectDependency[] @relation("ProjectDependentProjects")

  // Audit Fields
  createdAt            DateTime          @default(now()) @db.Timestamp
  updatedAt            DateTime          @updatedAt @db.Timestamp
  deletedAt            DateTime?         @db.Timestamp
  createdBy            String?           @db.Char(36)
  updatedBy            String?           @db.Char(36)
  deletedBy            String?           @db.Char(36)
  version              Int               @default(0)

  @@index([categoryId])
  @@index([clientId])
  @@index([proposalId])
  @@index([managerId])
  @@map("projects")
}

model ProjectTag {
  id        String    @id @default(uuid()) @db.Char(36)
  name      String    @unique @db.VarChar(100)
  projects  Project[] @relation("ProjectToTags")
  createdAt DateTime  @default(now()) @db.Timestamp
  updatedAt DateTime  @updatedAt @db.Timestamp

  @@map("project_tags")
}

model ProjectTemplate {
  id                   String      @id @default(uuid()) @db.Char(36)
  name                 String      @unique @db.VarChar(255)
  description          String?     @db.Text
  type                 ProjectType @default(FIXED_PRICE)
  estimatedHours       Decimal     @default(0.00) @db.Decimal(10, 2)
  estimatedTimelineDays Int         @default(30)
  config               Json?       // Stores milestones, default phases, required roles

  // Audit Fields
  createdAt            DateTime    @default(now()) @db.Timestamp
  updatedAt            DateTime    @updatedAt @db.Timestamp
  deletedAt            DateTime?   @db.Timestamp
  createdBy            String?     @db.Char(36)
  updatedBy            String?     @db.Char(36)
  deletedBy            String?     @db.Char(36)
  version              Int         @default(0)

  @@map("project_templates")
}

model ProjectPhase {
  id          String             @id @default(uuid()) @db.Char(36)
  projectId   String             @db.Char(36)
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String             @db.VarChar(100)
  code        String             @db.VarChar(50)
  sortOrder   Int                @default(0)
  startDate   DateTime?          @db.Date
  endDate     DateTime?          @db.Date
  milestones  ProjectMilestone[]

  // Audit Fields
  createdAt   DateTime           @default(now()) @db.Timestamp
  updatedAt   DateTime           @updatedAt @db.Timestamp
  deletedAt   DateTime?          @db.Timestamp
  createdBy   String?            @db.Char(36)
  updatedBy   String?            @db.Char(36)
  deletedBy   String?            @db.Char(36)
  version     Int                @default(0)

  @@unique([projectId, code])
  @@map("project_phases")
}

model ProjectMilestone {
  id                   String              @id @default(uuid()) @db.Char(36)
  projectId            String              @db.Char(36)
  project              Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  phaseId              String?             @db.Char(36)
  phase                ProjectPhase?       @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  
  title                String              @db.VarChar(255)
  description          String?             @db.Text
  dueDate              DateTime            @db.Date
  completionPercentage Int                 @default(0)
  status               MilestoneStatus     @default(PENDING)
  
  ownerId              String              @db.Char(36)
  owner                User                @relation("MilestoneOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  
  estimatedHours       Decimal             @default(0.00) @db.Decimal(10, 2)
  actualHours          Decimal             @default(0.00) @db.Decimal(10, 2)

  dependencies         ProjectDependency[] @relation("MilestoneDependencies")
  dependentMilestones  ProjectDependency[] @relation("MilestoneDependentMilestones")
  tasks                Task[]

  // Audit Fields
  createdAt            DateTime            @default(now()) @db.Timestamp
  updatedAt            DateTime            @updatedAt @db.Timestamp
  deletedAt            DateTime?           @db.Timestamp
  createdBy            String?             @db.Char(36)
  updatedBy            String?             @db.Char(36)
  deletedBy            String?             @db.Char(36)
  version              Int                 @default(0)

  @@index([projectId])
  @@index([phaseId])
  @@index([ownerId])
  @@map("project_milestones")
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Char(36)
  projectId String   @db.Char(36)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String   @db.Char(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      String   @db.VarChar(100) // PM, QA, Designer, Developer, Client

  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @updatedAt @db.Timestamp

  @@unique([projectId, userId, role])
  @@map("project_members")
}

model ProjectResource {
  id                   String    @id @default(uuid()) @db.Char(36)
  projectId            String    @db.Char(36)
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId               String    @db.Char(36)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  allocationPercentage Int       @default(100)
  startDate            DateTime  @db.Date
  endDate              DateTime  @db.Date
  role                 String    @db.VarChar(100)

  createdAt            DateTime  @default(now()) @db.Timestamp
  updatedAt            DateTime  @updatedAt @db.Timestamp

  @@index([projectId])
  @@index([userId])
  @@map("project_resources")
}

model ProjectDependency {
  id                   String            @id @default(uuid()) @db.Char(36)
  
  // Project level dependency
  projectId            String?           @db.Char(36)
  project              Project?          @relation("ProjectDependencies", fields: [projectId], references: [id], onDelete: Cascade)
  
  dependsOnProjectId   String?           @db.Char(36)
  dependsOnProject     Project?          @relation("ProjectDependentProjects", fields: [dependsOnProjectId], references: [id], onDelete: Cascade)

  // Milestone level dependency
  milestoneId          String?           @db.Char(36)
  milestone            ProjectMilestone? @relation("MilestoneDependencies", fields: [milestoneId], references: [id], onDelete: Cascade)
  
  dependsOnMilestoneId String?           @db.Char(36)
  dependsOnMilestone   ProjectMilestone? @relation("MilestoneDependentMilestones", fields: [dependsOnMilestoneId], references: [id], onDelete: Cascade)
  
  type                 DependencyType    @default(FS)

  createdAt            DateTime          @default(now()) @db.Timestamp

  @@index([projectId])
  @@index([dependsOnProjectId])
  @@index([milestoneId])
  @@index([dependsOnMilestoneId])
  @@map("project_dependencies")
}

model ProjectRisk {
  id             String          @id @default(uuid()) @db.Char(36)
  projectId      String          @db.Char(36)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String          @db.VarChar(255)
  description    String?         @db.Text
  probability    Int             @default(1) // 1 to 5
  impact         Int             @default(1) // 1 to 5
  riskScore      Int             @default(1) // prob * impact
  mitigationPlan String?         @db.Text
  
  ownerId        String?         @db.Char(36)
  owner          User?           @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  status         RiskStatus      @default(IDENTIFIED)

  // Audit Fields
  createdAt      DateTime        @default(now()) @db.Timestamp
  updatedAt      DateTime        @updatedAt @db.Timestamp
  deletedAt      DateTime?       @db.Timestamp
  createdBy      String?         @db.Char(36)
  updatedBy      String?         @db.Char(36)
  deletedBy      String?         @db.Char(36)
  version        Int             @default(0)

  @@index([projectId])
  @@map("project_risks")
}

model ProjectIssue {
  id           String        @id @default(uuid()) @db.Char(36)
  projectId    String        @db.Char(36)
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String        @db.VarChar(255)
  description  String?       @db.Text
  type         IssueType     @default(BUG)
  priority     IssuePriority @default(MEDIUM)
  severity     IssueSeverity @default(MEDIUM)
  status       IssueStatus   @default(OPEN)
  
  assignedToId String?       @db.Char(36)
  assignedTo   User?         @relation("IssueAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolution   String?       @db.Text

  // Audit Fields
  createdAt    DateTime      @default(now()) @db.Timestamp
  updatedAt    DateTime      @updatedAt @db.Timestamp
  deletedAt    DateTime?     @db.Timestamp
  createdBy      String?         @db.Char(36)
  updatedBy    String?       @db.Char(36)
  deletedBy    String?       @db.Char(36)
  version      Int           @default(0)

  @@index([projectId])
  @@map("project_issues")
}

model ProjectDocument {
  id         String                  @id @default(uuid()) @db.Char(36)
  projectId  String                  @db.Char(36)
  project    Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String                  @db.VarChar(255)
  fileKey    String                  @db.VarChar(255)
  category   ProjectDocumentCategory @default(OTHER)
  
  uploadedBy String                  @db.Char(36)
  uploadDate DateTime                @default(now()) @db.Timestamp

  // Audit Fields
  createdAt  DateTime                @default(now()) @db.Timestamp
  updatedAt  DateTime                @updatedAt @db.Timestamp
  deletedAt  DateTime?               @db.Timestamp
  deletedBy  String?                 @db.Char(36)

  @@index([projectId])
  @@map("project_documents")
}

model ProjectTimeline {
  id          String   @id @default(uuid()) @db.Char(36)
  projectId   String   @db.Char(36)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  event       String   @db.VarChar(100)
  description String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamp
  createdBy   String?  @db.Char(36)

  @@index([projectId])
  @@map("project_timelines")
}

// ====================================================
// Enterprise Task & Work Management Module (Sprint 7)
// ====================================================

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

model Sprint {
  id                   String        @id @default(uuid()) @db.Char(36)
  projectId            String        @db.Char(36)
  project              Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                 String        @db.VarChar(255)
  startDate            DateTime      @db.Date
  endDate              DateTime      @db.Date
  status               SprintStatus  @default(PLANNING)

  goals                SprintGoal[]
  tasks                Task[]

  // Audit Fields
  createdAt            DateTime      @default(now()) @db.Timestamp
  updatedAt            DateTime      @updatedAt @db.Timestamp
  deletedAt            DateTime?     @db.Timestamp
  createdBy            String?       @db.Char(36)
  updatedBy            String?       @db.Char(36)
  deletedBy            String?       @db.Char(36)
  version              Int           @default(0)

  @@index([projectId])
  @@map("sprints")
}

model SprintGoal {
  id                   String        @id @default(uuid()) @db.Char(36)
  sprintId             String        @db.Char(36)
  sprint               Sprint        @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  goal                 String        @db.Text
  isAchieved           Boolean       @default(false)

  createdAt            DateTime      @default(now()) @db.Timestamp
  updatedAt            DateTime      @updatedAt @db.Timestamp

  @@index([sprintId])
  @@map("sprint_goals")
}

model TaskType {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @unique @db.VarChar(100)
  code        String    @unique @db.VarChar(50)
  icon        String?   @db.VarChar(100)
  color       String?   @db.VarChar(50)
  tasks       Task[]

  // Audit Fields
  createdAt   DateTime  @default(now()) @db.Timestamp
  updatedAt   DateTime  @updatedAt @db.Timestamp
  deletedAt   DateTime? @db.Timestamp
  createdBy   String?   @db.Char(36)
  updatedBy   String?   @db.Char(36)
  deletedBy   String?   @db.Char(36)
  version     Int       @default(0)

  @@map("task_types")
}

model TaskStatus {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @unique @db.VarChar(100)
  code        String    @unique @db.VarChar(50)
  color       String?   @db.VarChar(50)
  sortOrder   Int       @default(0)
  tasks       Task[]

  // Audit Fields
  createdAt   DateTime  @default(now()) @db.Timestamp
  updatedAt   DateTime  @updatedAt @db.Timestamp
  deletedAt   DateTime? @db.Timestamp
  createdBy   String?   @db.Char(36)
  updatedBy   String?   @db.Char(36)
  deletedBy   String?   @db.Char(36)
  version     Int       @default(0)

  @@map("task_statuses")
}

model TaskPriority {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @unique @db.VarChar(100)
  code        String    @unique @db.VarChar(50)
  color       String?   @db.VarChar(50)
  sortOrder   Int       @default(0)
  tasks       Task[]

  // Audit Fields
  createdAt   DateTime  @default(now()) @db.Timestamp
  updatedAt   DateTime  @updatedAt @db.Timestamp
  deletedAt   DateTime? @db.Timestamp
  createdBy   String?   @db.Char(36)
  updatedBy   String?   @db.Char(36)
  deletedBy   String?   @db.Char(36)
  version     Int       @default(0)

  @@map("task_priorities")
}

model TaskLabel {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @unique @db.VarChar(100)
  color       String?   @db.VarChar(50)
  tasks       Task[]    @relation("TaskLabels")

  createdAt   DateTime  @default(now()) @db.Timestamp
  updatedAt   DateTime  @updatedAt @db.Timestamp

  @@map("task_labels")
}

model Task {
  id                   String            @id @default(uuid()) @db.Char(36)
  code                 String            @unique @db.VarChar(100)
  projectId            String            @db.Char(36)
  project              Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  milestoneId          String?           @db.Char(36)
  milestone            ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  sprintId             String?           @db.Char(36)
  sprint               Sprint?           @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  title                String            @db.VarChar(255)
  description          String?           @db.Text
  
  typeId               String            @db.Char(36)
  type                 TaskType          @relation(fields: [typeId], references: [id], onDelete: Restrict)

  statusId             String            @db.Char(36)
  status               TaskStatus        @relation(fields: [statusId], references: [id], onDelete: Restrict)

  priorityId           String            @db.Char(36)
  priority             TaskPriority      @relation(fields: [priorityId], references: [id], onDelete: Restrict)

  dueDate              DateTime?         @db.Date
  startDate            DateTime?         @db.Date

  estimatedHours       Decimal           @default(0.00) @db.Decimal(10, 2)
  actualHours          Decimal           @default(0.00) @db.Decimal(10, 2)
  remainingHours       Decimal           @default(0.00) @db.Decimal(10, 2)
  storyPoints          Int?
  progressPercentage   Int               @default(0)

  // Kanban ordering
  position             Int               @default(0)

  // Recurring Tasks support
  isRecurring          Boolean           @default(false)
  recurrenceRule       String?           @db.VarChar(255) // DAILY, WEEKLY, MONTHLY, YEARLY, CRON
  cronExpression       String?           @db.VarChar(255)
  nextRecurrenceDate   DateTime?         @db.Timestamp

  // Self-referencing Task hierarchy
  parentTaskId         String?           @db.Char(36)
  parentTask           Task?             @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: Cascade)
  childTasks           Task[]            @relation("TaskHierarchy")

  // Relations
  comments             TaskComment[]
  attachments          TaskAttachment[]
  watchers             TaskWatcher[]
  checklists           TaskChecklist[]
  labels               TaskLabel[]       @relation("TaskLabels")
  assignees            User[]            @relation("TaskAssignees")
  dependencies         TaskDependency[]  @relation("TaskDependencies")
  dependentOnMe        TaskDependency[]  @relation("TaskDependentTasks")
  timelines            TaskTimeline[]
  taskTimers           TaskTimer[]
  timeEntries          TimeEntry[]
  invoiceItems         InvoiceItem[]
  billableRates        BillableRate[]

  // Audit Fields
  createdAt            DateTime          @default(now()) @db.Timestamp
  updatedAt            DateTime          @updatedAt @db.Timestamp
  deletedAt            DateTime?         @db.Timestamp
  createdBy            String?           @db.Char(36)
  updatedBy            String?           @db.Char(36)
  deletedBy            String?           @db.Char(36)
  version              Int               @default(0)

  @@index([projectId])
  @@index([milestoneId])
  @@index([sprintId])
  @@index([typeId])
  @@index([statusId])
  @@index([priorityId])
  @@index([parentTaskId])
  @@map("tasks")
}

model TaskChecklist {
  id                   String              @id @default(uuid()) @db.Char(36)
  taskId               String              @db.Char(36)
  task                 Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title                String              @db.VarChar(255)
  items                TaskChecklistItem[]

  createdAt            DateTime            @default(now()) @db.Timestamp
  updatedAt            DateTime            @updatedAt @db.Timestamp

  @@index([taskId])
  @@map("task_checklists")
}

model TaskChecklistItem {
  id                   String        @id @default(uuid()) @db.Char(36)
  checklistId          String        @db.Char(36)
  checklist            TaskChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  title                String        @db.VarChar(255)
  isCompleted          Boolean       @default(false)
  sortOrder            Int           @default(0)

  createdAt            DateTime      @default(now()) @db.Timestamp
  updatedAt            DateTime      @updatedAt @db.Timestamp

  @@index([checklistId])
  @@map("task_checklist_items")
}

model TaskComment {
  id                   String        @id @default(uuid()) @db.Char(36)
  taskId               String        @db.Char(36)
  task                 Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  content              String        @db.Text
  
  authorId             String        @db.Char(36)
  author               User          @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  parentCommentId      String?       @db.Char(36)
  parentComment        TaskComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies              TaskComment[] @relation("CommentReplies")

  createdAt            DateTime      @default(now()) @db.Timestamp
  updatedAt            DateTime      @updatedAt @db.Timestamp
  deletedAt            DateTime?     @db.Timestamp

  @@index([taskId])
  @@index([authorId])
  @@index([parentCommentId])
  @@map("task_comments")
}

model TaskAttachment {
  id                   String        @id @default(uuid()) @db.Char(36)
  taskId               String        @db.Char(36)
  task                 Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name                 String        @db.VarChar(255)
  fileKey              String        @db.VarChar(255)
  fileSize             Int?
  mimeType             String?       @db.VarChar(100)
  
  uploadedById         String        @db.Char(36)
  uploadedBy           User          @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  
  uploadedAt           DateTime      @default(now()) @db.Timestamp

  @@index([taskId])
  @@index([uploadedById])
  @@map("task_attachments")
}

model TaskWatcher {
  id                   String        @id @default(uuid()) @db.Char(36)
  taskId               String        @db.Char(36)
  task                 Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId               String        @db.Char(36)
  user                 User          @relation("TaskWatcherUser", fields: [userId], references: [id], onDelete: Cascade)

  createdAt            DateTime      @default(now()) @db.Timestamp

  @@unique([taskId, userId])
  @@map("task_watchers")
}

model TaskDependency {
  id                   String         @id @default(uuid()) @db.Char(36)
  taskId               String         @db.Char(36)
  task                 Task           @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  
  dependsOnTaskId      String         @db.Char(36)
  dependsOnTask        Task           @relation("TaskDependentTasks", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  
  type                 DependencyType @default(FS)

  createdAt            DateTime       @default(now()) @db.Timestamp

  @@unique([taskId, dependsOnTaskId])
  @@map("task_dependencies")
}

model TaskTimeline {
  id                   String        @id @default(uuid()) @db.Char(36)
  taskId               String        @db.Char(36)
  task                 Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  event                String        @db.VarChar(100)
  description          String        @db.Text
  metadata             Json?
  createdAt            DateTime      @default(now()) @db.Timestamp
  createdBy            String?       @db.Char(36)

  @@index([taskId])
  @@map("task_timelines")
}

// ====================================================
// Time Tracking & Productivity Module (Sprint 8)
// ====================================================

enum AttendanceStatus {
  CHECK_IN
  CHECK_OUT
  LATE
  EARLY_LEAVE
  HOLIDAY
  WEEKEND
  ABSENT
  PRESENT
  HALF_DAY
  REMOTE
  WFH
}

enum TimeEntryCategory {
  DEVELOPMENT
  MEETING
  RESEARCH
  TRAINING
  SUPPORT
  INTERNAL
  SALES
  ADMINISTRATION
}

enum BreakType {
  LUNCH
  TEA
  PERSONAL
  MEETING
  CUSTOM
}

enum IdleType {
  SYSTEM_LOCK
  SCREEN_SAVER
  SLEEP
  SHUTDOWN
  OTHER
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  MANAGER_APPROVED
  FINANCE_APPROVED
  REJECTED
}

model WorkSession {
  id               String           @id @default(uuid()) @db.Char(36)
  userId           String           @db.Char(36)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime        DateTime         @db.Timestamp
  endTime          DateTime?        @db.Timestamp
  totalDuration    Int              @default(0) // seconds
  activeTime       Int              @default(0) // seconds
  idleTime         Int              @default(0) // seconds
  breakTime        Int              @default(0) // seconds
  productiveTime   Int              @default(0) // seconds
  unproductiveTime Int              @default(0) // seconds
  attendanceStatus AttendanceStatus @default(CHECK_IN)
  ipAddress        String?          @db.VarChar(50)
  userAgent        String?          @db.VarChar(255)

  breaks           BreakSession[]
  idles            IdleSession[]
  screenshots      Screenshot[]
  activityLogs     ActivityLog[]
  applications     ApplicationUsage[]
  websites         WebsiteUsage[]
  attendance       Attendance?

  // Audit Fields
  createdAt        DateTime         @default(now()) @db.Timestamp
  updatedAt        DateTime         @updatedAt @db.Timestamp

  @@index([userId])
  @@map("work_sessions")
}

model TaskTimer {
  id                 String    @id @default(uuid()) @db.Char(36)
  userId             String    @db.Char(36)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId             String    @db.Char(36)
  task               Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startTime          DateTime  @db.Timestamp
  pausedAt           DateTime? @db.Timestamp
  accumulatedTime    Int       @default(0) // seconds
  isRunning          Boolean   @default(true)
  description        String?   @db.Text
  lastHeartbeat      DateTime  @default(now()) @db.Timestamp
  recoveryFlag       Boolean   @default(false)
  resumeAfterRestart Boolean   @default(true)

  @@index([userId])
  @@index([taskId])
  @@map("task_timers")
}

model TimeEntry {
  id               String            @id @default(uuid()) @db.Char(36)
  userId           String            @db.Char(36)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId           String?           @db.Char(36)
  task             Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  projectId        String?           @db.Char(36)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  startTime        DateTime          @db.Timestamp
  endTime          DateTime          @db.Timestamp
  duration         Int               @default(0) // seconds
  description      String?           @db.Text
  billable         Boolean           @default(true)
  category         TimeEntryCategory @default(DEVELOPMENT)
  isManual         Boolean           @default(false)
  approved         Boolean           @default(false)
  dailyTimesheetId String?           @db.Char(36)
  dailyTimesheet   DailyTimesheet?   @relation(fields: [dailyTimesheetId], references: [id], onDelete: SetNull)
  billed           Boolean           @default(false)
  invoiceItems     InvoiceItem[]

  // Audit Fields
  createdAt        DateTime          @default(now()) @db.Timestamp
  updatedAt        DateTime          @updatedAt @db.Timestamp

  @@index([userId])
  @@index([taskId])
  @@index([projectId])
  @@index([dailyTimesheetId])
  @@map("time_entries")
}

model BreakSession {
  id            String      @id @default(uuid()) @db.Char(36)
  workSessionId String      @db.Char(36)
  workSession   WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)
  type          BreakType   @default(LUNCH)
  startTime     DateTime    @db.Timestamp
  endTime       DateTime?   @db.Timestamp
  duration      Int         @default(0) // seconds
  reason        String?     @db.VarChar(255)

  @@index([workSessionId])
  @@map("break_sessions")
}

model IdleSession {
  id            String      @id @default(uuid()) @db.Char(36)
  workSessionId String      @db.Char(36)
  workSession   WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)
  type          IdleType    @default(OTHER)
  startTime     DateTime    @db.Timestamp
  endTime       DateTime?   @db.Timestamp
  duration      Int         @default(0) // seconds
  reason        String?     @db.VarChar(255)

  @@index([workSessionId])
  @@map("idle_sessions")
}

model Screenshot {
  id            String      @id @default(uuid()) @db.Char(36)
  workSessionId String      @db.Char(36)
  workSession   WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)
  filePath      String      @db.VarChar(255)
  timestamp     DateTime    @db.Timestamp
  resolution    String?     @db.VarChar(50)
  monitor       Int         @default(1)
  isBlurred     Boolean     @default(true)
  isCompressed  Boolean     @default(false)
  checksum      String?     @db.VarChar(100)
  retentionDays Int         @default(30)

  @@index([workSessionId])
  @@map("screenshots")
}

model ActivityLog {
  id            String      @id @default(uuid()) @db.Char(36)
  workSessionId String      @db.Char(36)
  workSession   WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)
  timestamp     DateTime    @db.Timestamp
  keyboardCount Int         @default(0)
  mouseCount    Int         @default(0)
  clicksCount   Int         @default(0)
  scrollsCount  Int         @default(0)
  activityScore Decimal     @default(0.00) @db.Decimal(5, 2)

  @@index([workSessionId])
  @@map("activity_logs")
}

model ApplicationUsage {
  id            String      @id @default(uuid()) @db.Char(36)
  workSessionId String      @db.Char(36)
  workSession   WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)
  appName       String      @db.VarChar(255)
  duration      Int         @default(0) // seconds
  category      String?     @db.VarChar(50) // PRODUCTIVE, UNPRODUCTIVE, NEUTRAL

  @@index([workSessionId])
  @@map("application_usages")
}

model WebsiteUsage {
  id            String      @id @default(uuid()) @db.Char(36)
  workSessionId String      @db.Char(36)
  workSession   WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)
  domain        String      @db.VarChar(255)
  duration      Int         @default(0) // seconds
  category      String?     @db.VarChar(50) // PRODUCTIVE, UNPRODUCTIVE, NEUTRAL

  @@index([workSessionId])
  @@map("website_usages")
}

model DailyTimesheet {
  id            String          @id @default(uuid()) @db.Char(36)
  userId        String          @db.Char(36)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime        @db.Date
  totalHours    Decimal         @default(0.00) @db.Decimal(5, 2)
  billableHours Decimal         @default(0.00) @db.Decimal(5, 2)
  status        TimesheetStatus @default(DRAFT)
  timeEntries   TimeEntry[]

  // Audit Fields
  createdAt     DateTime        @default(now()) @db.Timestamp
  updatedAt     DateTime        @updatedAt @db.Timestamp

  @@unique([userId, date])
  @@map("daily_timesheets")
}

model WeeklyTimesheet {
  id            String              @id @default(uuid()) @db.Char(36)
  userId        String              @db.Char(36)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate     DateTime            @db.Date
  endDate       DateTime            @db.Date
  totalHours    Decimal             @default(0.00) @db.Decimal(5, 2)
  status        TimesheetStatus     @default(DRAFT)
  approvals     TimesheetApproval[]

  // Audit Fields
  createdAt     DateTime            @default(now()) @db.Timestamp
  updatedAt     DateTime            @updatedAt @db.Timestamp

  @@unique([userId, startDate])
  @@map("weekly_timesheets")
}

model TimesheetApproval {
  id                String          @id @default(uuid()) @db.Char(36)
  weeklyTimesheetId String          @db.Char(36)
  weeklyTimesheet   WeeklyTimesheet @relation(fields: [weeklyTimesheetId], references: [id], onDelete: Cascade)
  approverId        String          @db.Char(36)
  approver          User            @relation("TimesheetApprover", fields: [approverId], references: [id], onDelete: Cascade)
  status            TimesheetStatus @default(SUBMITTED)
  comments          String?         @db.Text
  actionedAt        DateTime?       @db.Timestamp

  @@index([weeklyTimesheetId])
  @@index([approverId])
  @@map("timesheet_approvals")
}

model ProductivityScore {
  id                     String   @id @default(uuid()) @db.Char(36)
  userId                 String   @db.Char(36)
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                   DateTime @db.Date
  score                  Decimal  @default(0.00) @db.Decimal(5, 2)
  focusTime              Int      @default(0) // seconds
  deepWorkTime           Int      @default(0) // seconds
  contextSwitches        Int      @default(0)
  interruptions          Int      @default(0)
  productivityPercentage Decimal  @default(0.00) @db.Decimal(5, 2)

  @@unique([userId, date])
  @@map("productivity_scores")
}

model UtilizationReport {
  id                    String   @id @default(uuid()) @db.Char(36)
  userId                String?  @db.Char(36)
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId             String?  @db.Char(36)
  project               Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  teamId                String?  @db.Char(36)
  departmentId          String?  @db.Char(36)
  date                  DateTime @db.Date
  billablePercentage    Decimal  @default(0.00) @db.Decimal(5, 2)
  nonBillablePercentage Decimal  @default(0.00) @db.Decimal(5, 2)

  @@index([userId])
  @@index([projectId])
  @@index([date])
  @@map("utilization_reports")
}

// ====================================================
// Finance & Billing Module (Sprint 9)
// ====================================================

enum TaxType {
  GST
  CGST
  SGST
  IGST
  VAT
  CUSTOM
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  VOID
}

enum InvoiceItemType {
  PRODUCT
  SERVICE
  TASK
  TIME_ENTRY
  MANUAL
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  MANAGER_APPROVED
  FINANCE_APPROVED
  PAID
  REJECTED
}

model Currency {
  id             String         @id @default(uuid()) @db.Char(36)
  code           String         @unique @db.VarChar(10)
  name           String         @db.VarChar(100)
  symbol         String         @db.VarChar(10)
  exchangeRate   Decimal        @default(1.000000) @db.Decimal(15, 6)
  isBase         Boolean        @default(false)
  conversionDate DateTime?      @db.Timestamp

  expenses       Expense[]
  purchases      Purchase[]
  billableRates  BillableRate[]
  estimates      Estimate[]
  invoices       Invoice[]
  recurring      RecurringInvoice[]

  @@map("currencies")
}

model Tax {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @db.VarChar(100)
  rate      Decimal  @db.Decimal(5, 2)
  type      TaxType  @default(CUSTOM)
  code      String   @unique @db.VarChar(50)
  isDefault Boolean  @default(false)

  @@map("taxes")
}

model Vendor {
  id                 String     @id @default(uuid()) @db.Char(36)
  name               String     @db.VarChar(255)
  companyName        String?    @db.VarChar(255)
  email              String?    @db.VarChar(255)
  phone              String?    @db.VarChar(50)
  taxNumber          String?    @db.VarChar(50)
  pan                String?    @db.VarChar(50)
  gst                String?    @db.VarChar(50)
  bankDetails        String?    @db.Text
  upi                String?    @db.VarChar(100)
  paymentTerms       String?    @db.VarChar(100)
  outstandingBalance Decimal    @default(0.00) @db.Decimal(15, 2)
  status             Status     @default(ACTIVE)

  expenses           Expense[]
  purchases          Purchase[]

  @@map("vendors")
}

model ExpenseCategory {
  id       String    @id @default(uuid()) @db.Char(36)
  name     String    @unique @db.VarChar(100)
  code     String    @unique @db.VarChar(50)
  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id          String        @id @default(uuid()) @db.Char(36)
  categoryId  String        @db.Char(36)
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  projectId   String?       @db.Char(36)
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId      String        @db.Char(36)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId    String?       @db.Char(36)
  vendor      Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  amount      Decimal       @db.Decimal(15, 2)
  currencyId  String        @db.Char(36)
  currency    Currency      @relation(fields: [currencyId], references: [id])
  date        DateTime      @db.Date
  description String?       @db.Text
  receiptPath String?       @db.VarChar(255)
  status      ExpenseStatus @default(DRAFT)

  // Audit Fields
  createdAt   DateTime      @default(now()) @db.Timestamp
  updatedAt   DateTime      @updatedAt @db.Timestamp

  @@index([categoryId])
  @@index([projectId])
  @@index([userId])
  @@index([vendorId])
  @@map("expenses")
}

model Purchase {
  id             String         @id @default(uuid()) @db.Char(36)
  purchaseNumber String         @unique @db.VarChar(50) // PO-YYYY-000001
  vendorId       String         @db.Char(36)
  vendor         Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  purchaseDate   DateTime       @db.Date
  status         String         @default("DRAFT") // DRAFT, SENT, RECEIVED, CANCELLED
  subtotal       Decimal        @db.Decimal(15, 2)
  discount       Decimal        @default(0.00) @db.Decimal(15, 2)
  tax            Decimal        @default(0.00) @db.Decimal(15, 2)
  total          Decimal        @db.Decimal(15, 2)
  currencyId     String         @db.Char(36)
  currency       Currency       @relation(fields: [currencyId], references: [id])
  items          PurchaseItem[]

  // Audit Fields
  createdAt      DateTime       @default(now()) @db.Timestamp
  updatedAt      DateTime       @updatedAt @db.Timestamp

  @@index([vendorId])
  @@map("purchases")
}

model PurchaseItem {
  id          String   @id @default(uuid()) @db.Char(36)
  purchaseId  String   @db.Char(36)
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productName String   @db.VarChar(255)
  quantity    Int      @default(1)
  rate        Decimal  @db.Decimal(15, 2)
  discount    Decimal  @default(0.00) @db.Decimal(15, 2)
  tax         Decimal  @default(0.00) @db.Decimal(5, 2)
  total       Decimal  @db.Decimal(15, 2)

  @@index([purchaseId])
  @@map("purchase_items")
}

model BillableRate {
  id           String    @id @default(uuid()) @db.Char(36)
  clientId     String?   @db.Char(36)
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId    String?   @db.Char(36)
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId       String?   @db.Char(36)
  task         Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  userId       String?   @db.Char(36)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  departmentId String?   @db.Char(36)
  rate         Decimal   @db.Decimal(15, 2)
  currencyId   String    @db.Char(36)
  currency     Currency  @relation(fields: [currencyId], references: [id])

  createdAt    DateTime  @default(now()) @db.Timestamp
  updatedAt    DateTime  @updatedAt @db.Timestamp

  @@index([clientId])
  @@index([projectId])
  @@index([taskId])
  @@index([userId])
  @@map("billable_rates")
}

model Estimate {
  id             String         @id @default(uuid()) @db.Char(36)
  estimateNumber String         @unique @db.VarChar(50) // EST-YYYY-000001
  clientId       String         @db.Char(36)
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  subject        String         @db.VarChar(255)
  status         EstimateStatus @default(DRAFT)
  subtotal       Decimal        @db.Decimal(15, 2)
  discount       Decimal        @default(0.00) @db.Decimal(15, 2)
  tax            Decimal        @default(0.00) @db.Decimal(15, 2)
  total          Decimal        @db.Decimal(15, 2)
  currencyId     String         @db.Char(36)
  currency       Currency       @relation(fields: [currencyId], references: [id])
  expiryDate     DateTime?      @db.Date
  items          EstimateItem[]

  createdAt      DateTime       @default(now()) @db.Timestamp
  updatedAt      DateTime       @updatedAt @db.Timestamp

  @@index([clientId])
  @@map("estimates")
}

model EstimateItem {
  id          String   @id @default(uuid()) @db.Char(36)
  estimateId  String   @db.Char(36)
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  description String   @db.VarChar(255)
  quantity    Int      @default(1)
  rate        Decimal  @db.Decimal(15, 2)
  discount    Decimal  @default(0.00) @db.Decimal(15, 2)
  tax         Decimal  @default(0.00) @db.Decimal(5, 2)
  total       Decimal  @db.Decimal(15, 2)

  @@index([estimateId])
  @@map("estimate_items")
}

model Invoice {
  id                 String                   @id @default(uuid()) @db.Char(36)
  invoiceNumber      String                   @unique @db.VarChar(50) // INV-YYYY-000001
  clientId           String                   @db.Char(36)
  client             Client                   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId          String?                  @db.Char(36)
  project            Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  recurringInvoiceId String?                  @db.Char(36)
  recurringInvoice   RecurringInvoice?        @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)
  status             InvoiceStatus            @default(DRAFT)
  issueDate          DateTime                 @db.Date
  dueDate            DateTime                 @db.Date
  subtotal           Decimal                  @db.Decimal(15, 2)
  discount           Decimal                  @default(0.00) @db.Decimal(15, 2)
  tax                Decimal                  @default(0.00) @db.Decimal(15, 2)
  total              Decimal                  @db.Decimal(15, 2)
  balanceDue         Decimal                  @db.Decimal(15, 2)
  currencyId         String                   @db.Char(36)
  currency           Currency                 @relation(fields: [currencyId], references: [id])
  
  items              InvoiceItem[]
  payments           InvoicePaymentAllocation[]
  timelines          InvoiceTimeline[]
  creditNotes        CreditNote[]
  debitNotes         DebitNote[]

  createdAt          DateTime                 @default(now()) @db.Timestamp
  updatedAt          DateTime                 @updatedAt @db.Timestamp

  @@index([clientId])
  @@index([projectId])
  @@map("invoices")
}

model InvoiceItem {
  id          String          @id @default(uuid()) @db.Char(36)
  invoiceId   String          @db.Char(36)
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type        InvoiceItemType @default(MANUAL)
  timeEntryId String?         @db.Char(36)
  timeEntry   TimeEntry?      @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)
  taskId      String?         @db.Char(36)
  task        Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  description String          @db.VarChar(255)
  quantity    Decimal         @db.Decimal(10, 2)
  rate        Decimal         @db.Decimal(15, 2)
  discount    Decimal         @default(0.00) @db.Decimal(15, 2)
  tax         Decimal         @default(0.00) @db.Decimal(5, 2)
  total       Decimal         @db.Decimal(15, 2)

  @@index([invoiceId])
  @@map("invoice_items")
}

model PaymentMethod {
  id       String           @id @default(uuid()) @db.Char(36)
  name     String           @unique @db.VarChar(100)
  code     String           @unique @db.VarChar(50)
  isSystem Boolean          @default(true)
  payments InvoicePayment[]

  @@map("payment_methods")
}

model InvoicePayment {
  id              String                     @id @default(uuid()) @db.Char(36)
  paymentDate     DateTime                   @db.Timestamp
  paymentMethodId String                     @db.Char(36)
  paymentMethod   PaymentMethod              @relation(fields: [paymentMethodId], references: [id])
  amount          Decimal                    @db.Decimal(15, 2)
  transactionId   String?                    @db.VarChar(100)
  status          String                     @default("COMPLETED") // PENDING, COMPLETED, FAILED
  allocations     InvoicePaymentAllocation[]
  createdAt       DateTime                   @default(now()) @db.Timestamp

  @@map("invoice_payments")
}

model InvoicePaymentAllocation {
  id              String         @id @default(uuid()) @db.Char(36)
  paymentId       String         @db.Char(36)
  payment         InvoicePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId       String         @db.Char(36)
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountAllocated Decimal        @db.Decimal(15, 2)
  createdAt       DateTime       @default(now()) @db.Timestamp

  @@index([paymentId])
  @@index([invoiceId])
  @@map("invoice_payment_allocations")
}

model RecurringInvoice {
  id            String    @id @default(uuid()) @db.Char(36)
  clientId      String    @db.Char(36)
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId     String?   @db.Char(36)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  frequency     String    @default("MONTHLY") // MONTHLY, QUARTERLY, YEARLY, CUSTOM
  amount        Decimal   @db.Decimal(15, 2)
  currencyId    String    @db.Char(36)
  currency      Currency  @relation(fields: [currencyId], references: [id])
  status        String    @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED
  lastRun       DateTime? @db.Timestamp
  nextRun       DateTime  @db.Timestamp
  failureCount  Int       @default(0)
  retryCount    Int       @default(0)
  invoices      Invoice[]

  createdAt     DateTime  @default(now()) @db.Timestamp
  updatedAt     DateTime  @updatedAt @db.Timestamp

  @@index([clientId])
  @@map("recurring_invoices")
}

model CreditNote {
  id         String   @id @default(uuid()) @db.Char(36)
  noteNumber String   @unique @db.VarChar(50) // CN-YYYY-000001
  invoiceId  String   @db.Char(36)
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(15, 2)
  reason     String?  @db.VarChar(255)
  date       DateTime @db.Date
  createdAt  DateTime @default(now()) @db.Timestamp

  @@index([invoiceId])
  @@map("credit_notes")
}

model DebitNote {
  id         String   @id @default(uuid()) @db.Char(36)
  noteNumber String   @unique @db.VarChar(50) // DN-YYYY-000001
  invoiceId  String   @db.Char(36)
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(15, 2)
  reason     String?  @db.VarChar(255)
  date       DateTime @db.Date
  createdAt  DateTime @default(now()) @db.Timestamp

  @@index([invoiceId])
  @@map("debit_notes")
}

model FinancialTransaction {
  id          String   @id @default(uuid()) @db.Char(36)
  type        String   // INCOME, EXPENSE, REFUND, TRANSFER, ADJUSTMENT
  amount      Decimal  @db.Decimal(15, 2)
  date        DateTime @db.Timestamp
  referenceId String?  @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamp

  @@map("financial_transactions")
}

model ProjectBilling {
  id          String   @id @default(uuid()) @db.Char(36)
  projectId   String   @db.Char(36)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  billingType String   // FIXED_PRICE, TIME_AND_MATERIAL, RETAINER, MILESTONE, RECURRING
  rateAmount  Decimal  @db.Decimal(15, 2)
  status      String   @default("ACTIVE")

  createdAt   DateTime @default(now()) @db.Timestamp
  updatedAt   DateTime @updatedAt @db.Timestamp

  @@index([projectId])
  @@map("project_billings")
}

model InvoiceTimeline {
  id          String   @id @default(uuid()) @db.Char(36)
  invoiceId   String   @db.Char(36)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  event       String   @db.VarChar(100)
  description String   @db.Text
  createdAt   DateTime @default(now()) @db.Timestamp

  @@index([invoiceId])
  @@map("invoice_timelines")
}

model LedgerAccount {
  id           String        @id @default(uuid()) @db.Char(36)
  name         String        @db.VarChar(100)
  code         String        @unique @db.VarChar(50) // e.g. "1010" Cash, "4000" Revenue, "5000" Expense
  type         String        // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  balance      Decimal       @default(0.00) @db.Decimal(15, 2)
  journalLines JournalLine[]
  createdAt    DateTime      @default(now()) @db.Timestamp

  @@map("ledger_accounts")
}

model JournalEntry {
  id          String        @id @default(uuid()) @db.Char(36)
  entryNumber String        @unique @db.VarChar(50) // JE-YYYY-000001
  date        DateTime      @db.Timestamp
  description String?       @db.Text
  lines       JournalLine[]
  createdAt   DateTime      @default(now()) @db.Timestamp

  @@map("journal_entries")
}

model JournalLine {
  id             String        @id @default(uuid()) @db.Char(36)
  journalEntryId String        @db.Char(36)
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String        @db.Char(36)
  account        LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit          Decimal       @default(0.00) @db.Decimal(15, 2)
  credit         Decimal       @default(0.00) @db.Decimal(15, 2)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

// ====================================================
// HR & Workforce Management Module (Sprint 10)
// ====================================================

enum EmploymentStatus {
  ACTIVE
  PROBATION
  NOTICE_PERIOD
  RESIGNED
  TERMINATED
}

enum LeaveStatus {
  DRAFT
  SUBMITTED
  MANAGER_APPROVED
  HR_APPROVED
  REJECTED
  CANCELLED
}

enum LeaveTypeEnum {
  CASUAL
  SICK
  EARNED
  MATERNITY
  PATERNITY
  COMP_OFF
  LOSS_OF_PAY
}

enum ShiftType {
  GENERAL
  MORNING
  EVENING
  NIGHT
  ROTATIONAL
  FLEXIBLE
  SPLIT
}

enum AssetStatus {
  ASSIGNED
  RETURNED
  LOST
  DAMAGED
  REPAIR
  DISPOSED
}

enum TimelineEventType {
  JOINED
  PROMOTION
  SALARY_REVISION
  DEPARTMENT_CHANGE
  TRANSFER
  AWARD
  WARNING
  SUSPENSION
  RESIGNATION
  TERMINATION
  EXIT_INTERVIEW
}

enum EmployeeDocumentCategory {
  RESUME
  OFFER_LETTER
  APPOINTMENT_LETTER
  CONTRACT
  PAN
  AADHAAR
  PASSPORT
  DRIVING_LICENSE
  CERTIFICATES
  EXPERIENCE_LETTER
}

model BusinessUnit {
  id        String     @id @default(uuid()) @db.Char(36)
  name      String     @db.VarChar(100)
  code      String     @unique @db.VarChar(50)
  divisions Division[]
  profiles  EmployeeProfile[]
  createdAt DateTime   @default(now()) @db.Timestamp

  @@map("business_units")
}

model Division {
  id             String          @id @default(uuid()) @db.Char(36)
  name           String          @db.VarChar(100)
  code           String          @unique @db.VarChar(50)
  businessUnitId String          @db.Char(36)
  businessUnit   BusinessUnit    @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  profiles       EmployeeProfile[]
  createdAt      DateTime        @default(now()) @db.Timestamp

  @@map("divisions")
}

model EmployeeProfile {
  id                 String             @id @default(uuid()) @db.Char(36)
  userId             String             @unique @db.Char(36)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode       String             @unique @db.VarChar(50)
  photo              String?            @db.VarChar(255)
  dateOfJoining      DateTime           @db.Date
  employmentStatus   EmploymentStatus   @default(PROBATION)
  bloodGroup         String?            @db.VarChar(10)
  nationality        String?            @db.VarChar(100)
  maritalStatus      String?            @db.VarChar(50)
  passport           String?            @db.VarChar(50)
  drivingLicense     String?            @db.VarChar(50)
  aadhaar            String?            @db.VarChar(50)
  pan                String?            @db.VarChar(50)
  bankDetails        String?            @db.Text
  
  // Organizational Hierarchy Extensions
  businessUnitId     String?            @db.Char(36)
  businessUnit       BusinessUnit?      @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)
  divisionId         String?            @db.Char(36)
  division           Division?          @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  
  reportingManagerId String?            @db.Char(36)
  skipLevelManagerId String?            @db.Char(36)
  
  // Future Payroll Placeholders
  payrollGroup       String?            @db.VarChar(100)
  salaryGrade        String?            @db.VarChar(50)
  costCenter         String?            @db.VarChar(50)
  employmentCategory String?            @db.VarChar(100) // Full-time, Part-time, Contractor, Intern

  // Relations
  documents          EmployeeDocument[]
  emergencyContacts  EmergencyContact[]
  skills             EmployeeSkill[]
  certifications     EmployeeCertification[]
  experiences        EmployeeExperience[]
  education          EmployeeEducation[]
  attendances        Attendance[]
  shiftAssignments   ShiftAssignment[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  overtimeRequests   OvertimeRequest[]
  performanceGoals   PerformanceGoal[]
  performanceReviews PerformanceReview[]
  trainingEnrollments TrainingEnrollment[]
  assetAssignments   AssetAssignment[]
  timeline           EmployeeTimeline[]

  createdAt          DateTime           @default(now()) @db.Timestamp
  updatedAt          DateTime           @updatedAt @db.Timestamp

  @@map("employee_profiles")
}

model EmployeeDocument {
  id                String           @id @default(uuid()) @db.Char(36)
  employeeProfileId String           @db.Char(36)
  employeeProfile   EmployeeProfile  @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  category          EmployeeDocumentCategory
  name              String           @db.VarChar(255)
  documentPath      String           @db.VarChar(255)
  uploadedAt        DateTime         @default(now()) @db.Timestamp

  @@map("employee_documents")
}

model EmergencyContact {
  id                String          @id @default(uuid()) @db.Char(36)
  employeeProfileId String          @db.Char(36)
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  name              String          @db.VarChar(100)
  relationship      String          @db.VarChar(50)
  phone             String          @db.VarChar(50)
  email             String?         @db.VarChar(100)

  @@map("emergency_contacts")
}

model EmployeeSkill {
  id                String          @id @default(uuid()) @db.Char(36)
  employeeProfileId String          @db.Char(36)
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  name              String          @db.VarChar(100)
  proficiency       String          @db.VarChar(50) // BEGINNER, INTERMEDIATE, EXPERT

  @@map("employee_skills")
}

model EmployeeCertification {
  id                 String          @id @default(uuid()) @db.Char(36)
  employeeProfileId  String          @db.Char(36)
  employeeProfile    EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  name               String          @db.VarChar(100)
  issuingOrganization String         @db.VarChar(100)
  issueDate          DateTime        @db.Date
  expiryDate         DateTime?       @db.Date
  credentialId       String?         @db.VarChar(100)

  @@map("employee_certifications")
}

model EmployeeExperience {
  id                String          @id @default(uuid()) @db.Char(36)
  employeeProfileId String          @db.Char(36)
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  companyName       String          @db.VarChar(100)
  designation       String          @db.VarChar(100)
  startDate         DateTime        @db.Date
  endDate           DateTime?       @db.Date
  description       String?         @db.Text

