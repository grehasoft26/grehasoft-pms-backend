model SEOActivityType {
  id           String                @id @default(uuid()) @db.Char(36)
  tenantId     String                @db.Char(36)
  name         String                @unique @db.VarChar(100)
  description  String?               @db.Text
  isActive     Boolean               @default(true)
  displayOrder Int                   @default(0)
  createdAt    DateTime              @default(now()) @db.Timestamp(0)
  updatedAt    DateTime              @updatedAt @db.Timestamp(0)
  deletedAt    DateTime?             @db.Timestamp(0)
  logItems     SEODailyWorkLogItem[]
  targets      SEOMonthlyTarget[]
  tasks        SEOTask[]

  @@map("seo_activity_types")
}

model SEODailyWorkLog {
  id                 String                @id @default(uuid()) @db.Char(36)
  tenantId           String                @db.Char(36)
  seoProjectId       String                @db.Char(36)
  logDate            DateTime              @db.Date
  executiveId        String                @db.Char(36)
  remarks            String?               @db.Text
  remarksByManager   String?               @db.Text
  status             SEOWorkLogStatus      @default(DRAFT)
  totalCount         Int                   @default(0)
  seoTaskId          String?               @db.Char(36)
  
  createdById        String                @db.Char(36)
  updatedById        String?               @db.Char(36)
  approvedById       String?               @db.Char(36)
  approvedAt         DateTime?             @db.Timestamp(0)
  rejectedById       String?               @db.Char(36)
  rejectedAt         DateTime?             @db.Timestamp(0)
  submittedAt        DateTime?             @db.Timestamp(0)
  
  createdAt          DateTime              @default(now()) @db.Timestamp(0)
  updatedAt          DateTime              @updatedAt @db.Timestamp(0)
  deletedAt          DateTime?             @db.Timestamp(0)

  seoProject         SEOProject            @relation(fields: [seoProjectId], references: [id], onDelete: Cascade)
  executive          User                  @relation("UserSeoLogs", fields: [executiveId], references: [id])
  createdBy          User                  @relation("UserSeoLogsCreated", fields: [createdById], references: [id])
  updatedBy          User?                 @relation("UserSeoLogsUpdated", fields: [updatedById], references: [id])
  approvedBy         User?                 @relation("UserSeoLogsApproved", fields: [approvedById], references: [id])
  rejectedBy         User?                 @relation("UserSeoLogsRejected", fields: [rejectedById], references: [id])
  seoTask            SEOTask?              @relation(fields: [seoTaskId], references: [id])
  items              SEODailyWorkLogItem[]
  proofs             SEODailyWorkProof[]

  @@unique([executiveId, seoProjectId, logDate])
  @@map("seo_daily_work_logs")
}

model SEODailyWorkProof {
  id           String          @id @default(uuid()) @db.Char(36)
  tenantId     String          @db.Char(36)
  workLogId    String          @db.Char(36)
  proofFileUrl String          @db.VarChar(255)
  fileName     String          @db.VarChar(255)
  uploadedAt   DateTime        @default(now()) @db.Timestamp(0)
  workLog      SEODailyWorkLog @relation(fields: [workLogId], references: [id], onDelete: Cascade)

  @@map("seo_daily_work_proofs")
}

model SEODailyWorkLogItem {
  id               String           @id @default(uuid()) @db.Char(36)
  tenantId         String           @db.Char(36)
  workLogId        String           @db.Char(36)
  activityTypeId   String           @db.Char(36)
  count            Int              @default(1)
  keyword          String?          @db.VarChar(255)
  targetUrl        String?          @db.VarChar(255)
  submissionUrl    String?          @db.Text
  domainAuthority  Int?
  spamScore        Int?
  timeSpentMinutes Int?
  username         String?          @db.VarChar(255)
  password         String?          @db.Text
  anchorText       String?          @db.VarChar(255)
  remarks          String?          @db.Text
  status           SEOWorkLogStatus @default(DRAFT)
  createdAt        DateTime         @default(now()) @db.Timestamp(0)

  workLog          SEODailyWorkLog  @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  activityType     SEOActivityType  @relation(fields: [activityTypeId], references: [id])

  @@map("seo_daily_work_log_items")
}

model SEOMonthlyTarget {
  id             String          @id @default(uuid()) @db.Char(36)
  tenantId       String          @db.Char(36)
  executiveId    String          @db.Char(36)
  seoProjectId   String?         @db.Char(36)
  month          String          @db.VarChar(7) // YYYY-MM
  activityTypeId String          @db.Char(36)
  targetCount    Int             @default(0)
  createdAt      DateTime        @default(now()) @db.Timestamp(0)
  updatedAt      DateTime        @updatedAt @db.Timestamp(0)
  deletedAt      DateTime?       @db.Timestamp(0)

  executive      User            @relation("UserSeoTargets", fields: [executiveId], references: [id])
  seoProject     SEOProject?     @relation(fields: [seoProjectId], references: [id], onDelete: Cascade)
  activityType   SEOActivityType @relation(fields: [activityTypeId], references: [id])

  @@map("seo_monthly_targets")
}

model SEOTask {
  id                  String             @id @default(uuid()) @db.Char(36)
  tenantId            String             @db.Char(36)
  title               String             @db.VarChar(255)
  description         String             @db.Text
  reviewStatus        String?            @db.VarChar(20) // pending, approved, rejected
  managerRemarks      String?            @db.Text
  seoProjectId        String             @db.Char(36)
  assignedExecutiveId String             @db.Char(36)
  dueDate             DateTime           @db.Date
  priority            String             @default("medium") @db.VarChar(20) // low, medium, high
  status              String             @default("pending") @db.VarChar(20) // pending, in_progress, ready_for_review, completed, on_hold, overdue
  activityTypeId      String?            @db.Char(36)
  createdById         String             @db.Char(36)
  createdAt           DateTime           @default(now()) @db.Timestamp(0)
  updatedAt           DateTime           @updatedAt @db.Timestamp(0)
  deletedAt           DateTime?          @db.Timestamp(0)

  seoProject         SEOProject         @relation(fields: [seoProjectId], references: [id], onDelete: Cascade)
  assignedExecutive  User               @relation("UserAssignedSeoTasks", fields: [assignedExecutiveId], references: [id])
  createdBy          User               @relation("UserCreatedSeoTasks", fields: [createdById], references: [id])
  activityType       SEOActivityType?   @relation(fields: [activityTypeId], references: [id])
  dailyLogs          SEODailyWorkLog[]
  timelines          SEOTaskTimeline[]

  @@map("seo_tasks")
}

model SEOTaskTimeline {
  id        String    @id @default(uuid()) @db.Char(36)
  tenantId  String    @db.Char(36)
  taskId    String    @db.Char(36)
  eventTime DateTime  @default(now()) @db.Timestamp(0)
  userId    String?   @db.Char(36)
  userName  String?   @db.VarChar(255)
  action    String    @db.VarChar(100)
  remarks   String?   @db.Text
  task      SEOTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@map("seo_task_timelines")
}

model SEOCredential {
  id           String     @id @default(uuid()) @db.Char(36)
  tenantId     String     @db.Char(36)
  seoProjectId String     @db.Char(36)
  platform     String     @db.VarChar(100)
  username     String     @db.VarChar(255)
  notes        String?    @db.Text
  createdAt    DateTime   @default(now()) @db.Timestamp(0)
  updatedAt    DateTime   @updatedAt @db.Timestamp(0)
  deletedAt    DateTime?  @db.Timestamp(0)
  seoProject   SEOProject @relation(fields: [seoProjectId], references: [id], onDelete: Cascade)

  @@map("seo_credentials")
}

model SEOReminder {
  id                  String     @id @default(uuid()) @db.Char(36)
  tenantId            String     @db.Char(36)
  title               String     @db.VarChar(255)
  description         String?    @db.Text
  seoProjectId        String     @db.Char(36)
  assignedExecutiveId String     @db.Char(36)
  dueDate             DateTime   @db.Date
  priority            String     @default("medium") @db.VarChar(20) // low, medium, high
  status              String     @default("pending") @db.VarChar(20) // pending, completed
  createdById         String     @db.Char(36)
  createdAt           DateTime   @default(now()) @db.Timestamp(0)
  updatedAt           DateTime   @updatedAt @db.Timestamp(0)
  deletedAt           DateTime?  @db.Timestamp(0)

  seoProject         SEOProject @relation(fields: [seoProjectId], references: [id], onDelete: Cascade)
  assignedExecutive  User       @relation("UserAssignedSeoReminders", fields: [assignedExecutiveId], references: [id])
  createdBy          User       @relation("UserCreatedSeoReminders", fields: [createdById], references: [id])

  @@map("seo_reminders")
}

model Company {
  id              String           @id @default(uuid()) @db.Char(36)
  name            String           @unique @db.VarChar(255)
  status          String           @default("ACTIVE") @db.VarChar(50)
  createdAt       DateTime         @default(now()) @db.Timestamp(0)
  updatedAt       DateTime         @updatedAt @db.Timestamp(0)
  
  users           User[]
  features        CompanyFeature[]

  @@map("companies")
}

model CompanyFeature {
  id              String           @id @default(uuid()) @db.Char(36)
  companyId       String           @db.Char(36)
  featureKey      String           @db.VarChar(100)
  isEnabled       Boolean          @default(true)
  createdAt       DateTime         @default(now()) @db.Timestamp(0)
  updatedAt       DateTime         @updatedAt @db.Timestamp(0)
  
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, featureKey], name: "uq_company_feature")
  @@index([companyId], map: "company_features_companyId_fkey")
  @@map("company_features")
}
