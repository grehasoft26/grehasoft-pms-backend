model LeaveBalance {
  id                String          @id @default(uuid()) @db.Char(36)
  employeeProfileId String          @db.Char(36)
  leaveTypeId       String          @db.Char(36)
  allocated         Float
  used              Float           @default(0)
  remaining         Float
  createdAt         DateTime        @default(now()) @db.Timestamp(0)
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  leaveType         LeaveType       @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, leaveTypeId])
  @@index([leaveTypeId], map: "leave_balances_leaveTypeId_fkey")
  @@map("leave_balances")
}

model LeaveRequest {
  id                String          @id @default(uuid()) @db.Char(36)
  employeeProfileId String          @db.Char(36)
  leaveTypeId       String          @db.Char(36)
  startDate         DateTime        @db.Date
  endDate           DateTime        @db.Date
  isHalfDay         Boolean         @default(false)
  isHourly          Boolean         @default(false)
  hoursRequested    Float?
  reason            String?         @db.Text
  status            LeaveStatus     @default(SUBMITTED)
  createdAt         DateTime        @default(now()) @db.Timestamp(0)
  updatedAt         DateTime        @updatedAt @db.Timestamp(0)
  approvals         LeaveApproval[]
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  leaveType         LeaveType       @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([employeeProfileId], map: "leave_requests_employeeProfileId_fkey")
  @@index([leaveTypeId], map: "leave_requests_leaveTypeId_fkey")
  @@map("leave_requests")
}

model LeaveApproval {
  id             String       @id @default(uuid()) @db.Char(36)
  leaveRequestId String       @db.Char(36)
  approverId     String       @db.Char(36)
  status         LeaveStatus
  comments       String?      @db.Text
  createdAt      DateTime     @default(now()) @db.Timestamp(0)
  approver       User         @relation("LeaveRequestApprover", fields: [approverId], references: [id], onDelete: Cascade)
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@index([approverId], map: "leave_approvals_approverId_fkey")
  @@index([leaveRequestId], map: "leave_approvals_leaveRequestId_fkey")
  @@map("leave_approvals")
}

model LeaveBlackoutDate {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @db.VarChar(100)
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  description String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamp(0)

  @@map("leave_blackout_dates")
}

model OvertimeRequest {
  id                String          @id @default(uuid()) @db.Char(36)
  employeeProfileId String          @db.Char(36)
  date              DateTime        @db.Date
  hours             Float
  reason            String          @db.Text
  status            LeaveStatus     @default(SUBMITTED)
  approvedById      String?         @db.Char(36)
  createdAt         DateTime        @default(now()) @db.Timestamp(0)
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([employeeProfileId], map: "overtime_requests_employeeProfileId_fkey")
  @@map("overtime_requests")
}

model PerformanceGoal {
  id                String          @id @default(uuid()) @db.Char(36)
  employeeProfileId String          @db.Char(36)
  title             String          @db.VarChar(255)
  kpi               String?         @db.Text
  competencies      String?         @db.Text
  targetDate        DateTime        @db.Date
  progress          Float           @default(0)
  createdAt         DateTime        @default(now()) @db.Timestamp(0)
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([employeeProfileId], map: "performance_goals_employeeProfileId_fkey")
  @@map("performance_goals")
}

model PerformanceCycle {
  id        String              @id @default(uuid()) @db.Char(36)
  name      String              @db.VarChar(100)
  startDate DateTime            @db.Date
  endDate   DateTime            @db.Date
  createdAt DateTime            @default(now()) @db.Timestamp(0)
  reviews   PerformanceReview[]

  @@map("performance_cycles")
}

model PerformanceReview {
  id                String                      @id @default(uuid()) @db.Char(36)
  employeeProfileId String                      @db.Char(36)
  cycleId           String                      @db.Char(36)
  managerId         String                      @db.Char(36)
  selfRating        Int?
  managerRating     Int?
  finalRating       Int?
  selfFeedback      String?                     @db.Text
  managerFeedback   String?                     @db.Text
  finalFeedback     String?                     @db.Text
  status            String                      @default("DRAFT")
  createdAt         DateTime                    @default(now()) @db.Timestamp(0)
  updatedAt         DateTime                    @updatedAt @db.Timestamp(0)
  pip               PerformanceImprovementPlan?
  cycle             PerformanceCycle            @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeProfile   EmployeeProfile             @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  manager           User                        @relation("PerformanceManagerReviewer", fields: [managerId], references: [id], onDelete: Cascade)

  @@index([cycleId], map: "performance_reviews_cycleId_fkey")
  @@index([employeeProfileId], map: "performance_reviews_employeeProfileId_fkey")
  @@index([managerId], map: "performance_reviews_managerId_fkey")
  @@map("performance_reviews")
}

model PerformanceImprovementPlan {
  id        String            @id @default(uuid()) @db.Char(36)
  reviewId  String            @unique @db.Char(36)
  goals     String            @db.Text
  startDate DateTime          @db.Date
  endDate   DateTime          @db.Date
  status    String            @default("ACTIVE")
  createdAt DateTime          @default(now()) @db.Timestamp(0)
  review    PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("performance_improvement_plans")
}

model TrainingCourse {
  id            String               @id @default(uuid()) @db.Char(36)
  title         String               @db.VarChar(255)
  description   String?              @db.Text
  durationHours Int
  isMandatory   Boolean              @default(false)
  isExternal    Boolean              @default(false)
  createdAt     DateTime             @default(now()) @db.Timestamp(0)
  enrollments   TrainingEnrollment[]

  @@map("training_courses")
}

model TrainingEnrollment {
  id                String               @id @default(uuid()) @db.Char(36)
  employeeProfileId String               @db.Char(36)
  courseId          String               @db.Char(36)
  enrollmentDate    DateTime             @default(now()) @db.Timestamp(0)
  completionDate    DateTime?            @db.Date
  status            String               @default("ENROLLED")
  createdAt         DateTime             @default(now()) @db.Timestamp(0)
  certificate       TrainingCertificate?
  course            TrainingCourse       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employeeProfile   EmployeeProfile      @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([courseId], map: "training_enrollments_courseId_fkey")
  @@index([employeeProfileId], map: "training_enrollments_employeeProfileId_fkey")
  @@map("training_enrollments")
}

model TrainingCertificate {
  id                String             @id @default(uuid()) @db.Char(36)
  enrollmentId      String             @unique @db.Char(36)
  certificateNumber String             @unique @db.VarChar(100)
  issueDate         DateTime           @db.Date
  expiryDate        DateTime?          @db.Date
  renewalReminded   Boolean            @default(false)
  createdAt         DateTime           @default(now()) @db.Timestamp(0)
  enrollment        TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("training_certificates")
}

model AssetAssignment {
  id                String          @id @default(uuid()) @db.Char(36)
  employeeProfileId String          @db.Char(36)
  assetType         String          @db.VarChar(100)
  modelName         String?         @db.VarChar(100)
  serialNumber      String          @db.VarChar(100)
  warrantyMonths    Int             @default(12)
  purchaseDate      DateTime        @db.Date
  vendor            String          @db.VarChar(100)
  assignedDate      DateTime        @db.Date
  returnedDate      DateTime?       @db.Date
  status            AssetStatus     @default(ASSIGNED)
  createdAt         DateTime        @default(now()) @db.Timestamp(0)
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([employeeProfileId], map: "asset_assignments_employeeProfileId_fkey")
  @@map("asset_assignments")
}

model EmployeeTimeline {
  id                String            @id @default(uuid()) @db.Char(36)
  employeeProfileId String            @db.Char(36)
  event             TimelineEventType
  description       String            @db.Text
  date              DateTime          @default(now()) @db.Timestamp(0)
  employeeProfile   EmployeeProfile   @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([employeeProfileId], map: "employee_timelines_employeeProfileId_fkey")
  @@map("employee_timelines")
}

model InfrastructureProvider {
  id              String           @id @default(uuid()) @db.Char(36)
  name            String           @db.VarChar(255)
  code            String           @unique @db.VarChar(100)
  apiEndpoint     String?          @db.VarChar(255)
  status          Status           @default(ACTIVE)
  createdAt       DateTime         @default(now()) @db.Timestamp(0)
  updatedAt       DateTime         @updatedAt @db.Timestamp(0)
  hostingAccounts HostingAccount[]
  hostingPlans    HostingPlan[]
  servers         Server[]

  @@map("infrastructure_providers")
}

model HostingAccount {
  id               String                     @id @default(uuid()) @db.Char(36)
  clientId         String?                    @db.Char(36)
  projectId        String?                    @db.Char(36)
  providerId       String                     @db.Char(36)
  accountUsername  String                     @db.VarChar(100)
  controlPanelUrl  String?                    @db.VarChar(255)
  status           InfrastructureStatus       @default(ACTIVE)
  hostingPlanId    String?                    @db.Char(36)
  diskLimitGb      Decimal?                   @db.Decimal(10, 2)
  diskUsedGb       Decimal?                   @db.Decimal(10, 2)
  bandwidthLimitGb Decimal?                   @db.Decimal(10, 2)
  bandwidthUsedGb  Decimal?                   @db.Decimal(10, 2)
  notes            String?                    @db.Text
  createdAt        DateTime                   @default(now()) @db.Timestamp(0)
  updatedAt        DateTime                   @updatedAt @db.Timestamp(0)
  backupSchedules  BackupSchedule[]
  backups          Backup[]
  client           Client?                    @relation(fields: [clientId], references: [id])
  hostingPlan      HostingPlan?               @relation(fields: [hostingPlanId], references: [id])
  project          Project?                   @relation(fields: [projectId], references: [id])
  provider         InfrastructureProvider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  credentials      InfrastructureCredential[]

  @@index([clientId], map: "hosting_accounts_clientId_fkey")
  @@index([hostingPlanId], map: "hosting_accounts_hostingPlanId_fkey")
  @@index([projectId], map: "hosting_accounts_projectId_fkey")
  @@index([providerId], map: "hosting_accounts_providerId_fkey")
  @@map("hosting_accounts")
}

model HostingPlan {
  id           String                 @id @default(uuid()) @db.Char(36)
  providerId   String                 @db.Char(36)
  name         String                 @db.VarChar(100)
  diskGb       Int
  ramGb        Decimal                @db.Decimal(10, 2)
  cpuCores     Int
  bandwidthGb  Int
  priceMonthly Decimal?               @db.Decimal(10, 2)
  createdAt    DateTime               @default(now()) @db.Timestamp(0)
  updatedAt    DateTime               @updatedAt @db.Timestamp(0)
  accounts     HostingAccount[]
  provider     InfrastructureProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId], map: "hosting_plans_providerId_fkey")
  @@map("hosting_plans")
}

model Server {
  id                  String                     @id @default(uuid()) @db.Char(36)
  name                String                     @db.VarChar(255)
  ipAddress           String                     @db.VarChar(50)
  sshPort             Int                        @default(22)
  os                  String                     @db.VarChar(100)
  location            String?                    @db.VarChar(100)
  providerId          String?                    @db.Char(36)
  type                ServerType                 @default(VPS)
  status              InfrastructureStatus       @default(ACTIVE)
  diskGb              Int?
  ramGb               Decimal?                   @db.Decimal(10, 2)
  cpuCores            Int?
  clientId            String?                    @db.Char(36)
  projectId           String?                    @db.Char(36)
  createdAt           DateTime                   @default(now()) @db.Timestamp(0)
  updatedAt           DateTime                   @updatedAt @db.Timestamp(0)
  backupSchedules     BackupSchedule[]
  backups             Backup[]
  incidents           Incident[]
  credentials         InfrastructureCredential[]
  monitoringChecks    MonitoringCheck[]
  serverEnvironments  ServerEnvironment[]
  owner               String?                    @db.VarChar(255)
  serverIp            String?                    @db.VarChar(100)
  domains             Domain[]
  client              Client?                    @relation(fields: [clientId], references: [id])
  project             Project?                   @relation(fields: [projectId], references: [id])
  provider            InfrastructureProvider?    @relation(fields: [providerId], references: [id])
  infrastructure_tags InfrastructureTag[]        @relation("servertoinfratags")

  @@index([clientId], map: "servers_clientId_fkey")
  @@index([projectId], map: "servers_projectId_fkey")
  @@index([providerId], map: "servers_providerId_fkey")
  @@map("servers")
}

model ServerEnvironment {
  id          String               @id @default(uuid()) @db.Char(36)
  serverId    String               @db.Char(36)
  projectId   String?              @db.Char(36)
  environment Environment
  name        String               @db.VarChar(100)
  domainName  String?              @db.VarChar(255)
  status      InfrastructureStatus @default(ACTIVE)
  createdAt   DateTime             @default(now()) @db.Timestamp(0)
  updatedAt   DateTime             @updatedAt @db.Timestamp(0)
  deployments Deployment[]
  project     Project?             @relation(fields: [projectId], references: [id])
  server      Server               @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "server_environments_projectId_fkey")
  @@index([serverId], map: "server_environments_serverId_fkey")
  @@map("server_environments")
}

model Deployment {
  id                         String              @id @default(uuid()) @db.Char(36)
  projectId                  String              @db.Char(36)
  serverEnvironmentId        String              @db.Char(36)
  repositoryBranchId         String?             @db.Char(36)
  commitHash                 String?             @db.VarChar(100)
  startedById                String              @db.Char(36)
  status                     DeploymentStatus    @default(PENDING)
  rollbackSupport            Boolean             @default(true)
  duration                   Int?
  rollbackReason             String?             @db.Text
  buildLogs                  String?             @db.LongText
  environmentVariableVersion Int                 @default(1)
  startedAt                  DateTime            @default(now()) @db.Timestamp(0)
  finishedAt                 DateTime?           @db.Timestamp(0)
  createdAt                  DateTime            @default(now()) @db.Timestamp(0)
  updatedAt                  DateTime            @updatedAt @db.Timestamp(0)
  historyLogs                DeploymentHistory[]
  project                    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryBranch           RepositoryBranch?   @relation(fields: [repositoryBranchId], references: [id])
  serverEnvironment          ServerEnvironment   @relation(fields: [serverEnvironmentId], references: [id], onDelete: Cascade)
  startedBy                  User                @relation("UserDeployments", fields: [startedById], references: [id])

  @@index([projectId], map: "deployments_projectId_fkey")
  @@index([repositoryBranchId], map: "deployments_repositoryBranchId_fkey")
  @@index([serverEnvironmentId], map: "deployments_serverEnvironmentId_fkey")
  @@index([startedById], map: "deployments_startedById_fkey")
  @@map("deployments")
}

model DeploymentHistory {
  id           String           @id @default(uuid()) @db.Char(36)
  deploymentId String           @db.Char(36)
  logMessage   String           @db.Text
  status       DeploymentStatus
  createdAt    DateTime         @default(now()) @db.Timestamp(0)
  deployment   Deployment       @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId], map: "deployment_histories_deploymentId_fkey")
  @@map("deployment_histories")
}

model Repository {
  id              String             @id @default(uuid()) @db.Char(36)
  projectId       String?            @db.Char(36)
  name            String             @db.VarChar(255)
  url             String             @db.VarChar(255)
  owner           String?            @db.VarChar(100)
  visibility      String             @default("PRIVATE")
  primaryLanguage String?            @db.VarChar(50)
  defaultBranch   String             @default("main") @db.VarChar(100)
  lastCommit      String?            @db.VarChar(100)
  lastSync        DateTime?          @db.Timestamp(0)
  webhookEnabled  Boolean            @default(false)
  createdAt       DateTime           @default(now()) @db.Timestamp(0)
  updatedAt       DateTime           @updatedAt @db.Timestamp(0)
  project         Project?           @relation(fields: [projectId], references: [id])
  branches        RepositoryBranch[]

  @@index([projectId], map: "repositories_projectId_fkey")
  @@map("repositories")
}

model RepositoryBranch {
  id           String       @id @default(uuid()) @db.Char(36)
  repositoryId String       @db.Char(36)
  name         String       @db.VarChar(100)
  createdAt    DateTime     @default(now()) @db.Timestamp(0)
  updatedAt    DateTime     @updatedAt @db.Timestamp(0)
  deployments  Deployment[]
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId], map: "repository_branches_repositoryId_fkey")
  @@map("repository_branches")
}

model Domain {
  id                  String                     @id @default(uuid()) @db.Char(36)
  clientId            String?                    @db.Char(36)
  projectId           String?                    @db.Char(36)
  name                String                     @unique @db.VarChar(255)
  registrar           String                     @db.VarChar(100)
  purchaseDate        DateTime                   @db.Date
  expiryDate          DateTime                   @db.Date
  autoRenew           Boolean                    @default(true)
  privacyProtection   Boolean                    @default(false)
  registrarLock       Boolean                    @default(true)
  transferLock        Boolean                    @default(true)
  purchaseCost        Decimal?                   @db.Decimal(10, 2)
  renewalCost         Decimal?                   @db.Decimal(10, 2)
  renewalReminderDays Int                        @default(30)
  whoisRaw            String?                    @db.Text
  dnsSecEnabled       Boolean                    @default(false)
  nameservers         String?                    @db.VarChar(512)
  status              InfrastructureStatus       @default(ACTIVE)
  createdAt           DateTime                   @default(now()) @db.Timestamp(0)
  updatedAt           DateTime                   @updatedAt @db.Timestamp(0)
  dnsRecords          DNSRecord[]
  serverId            String?                    @db.Char(36)
  server              Server?                    @relation(fields: [serverId], references: [id], onDelete: SetNull)
  client              Client?                    @relation(fields: [clientId], references: [id])
  project             Project?                   @relation(fields: [projectId], references: [id])
  incidents           Incident[]
  credentials         InfrastructureCredential[]
  monitoringChecks    MonitoringCheck[]
  sslCertificates     SSLCertificate[]
  subDomains          SubDomain[]
  infrastructure_tags InfrastructureTag[]        @relation("domaintoinfratags")

  @@index([clientId], map: "domains_clientId_fkey")
  @@index([projectId], map: "domains_projectId_fkey")
  @@index([serverId], map: "domains_serverId_fkey")
  @@map("domains")
}

model SubDomain {
  id              String               @id @default(uuid()) @db.Char(36)
  domainId        String               @db.Char(36)
  name            String               @db.VarChar(100)
  targetIp        String?              @db.VarChar(50)
  status          InfrastructureStatus @default(ACTIVE)
  createdAt       DateTime             @default(now()) @db.Timestamp(0)
  updatedAt       DateTime             @updatedAt @db.Timestamp(0)
  sslCertificates SSLCertificate[]
  domain          Domain               @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId], map: "sub_domains_domainId_fkey")
  @@map("sub_domains")
}

model DNSRecord {
  id        String   @id @default(uuid()) @db.Char(36)
  domainId  String   @db.Char(36)
  type      String   @db.VarChar(20)
  host      String   @db.VarChar(255)
  value     String   @db.Text
  ttl       Int      @default(3600)
  priority  Int?
  createdAt DateTime @default(now()) @db.Timestamp(0)
  updatedAt DateTime @updatedAt @db.Timestamp(0)
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId], map: "dns_records_domainId_fkey")
  @@map("dns_records")
}

model SSLCertificate {
  id               String               @id @default(uuid()) @db.Char(36)
  domainId         String?              @db.Char(36)
  subDomainId      String?              @db.Char(36)
  issuer           String               @db.VarChar(100)
  issuedDate       DateTime             @db.Date
  expiryDate       DateTime             @db.Date
  wildcard         Boolean              @default(false)
  autoRenewal      Boolean              @default(false)
  daysRemaining    Int?
  renewalStatus    String               @default("GOOD")
  status           InfrastructureStatus @default(ACTIVE)
  createdAt        DateTime             @default(now()) @db.Timestamp(0)
  updatedAt        DateTime             @updatedAt @db.Timestamp(0)
  monitoringChecks MonitoringCheck[]
  domain           Domain?              @relation(fields: [domainId], references: [id])
  subDomain        SubDomain?           @relation(fields: [subDomainId], references: [id])

  @@index([domainId], map: "ssl_certificates_domainId_fkey")
  @@index([subDomainId], map: "ssl_certificates_subDomainId_fkey")
  @@map("ssl_certificates")
}

model Backup {
  id               String          @id @default(uuid()) @db.Char(36)
  serverId         String?         @db.Char(36)
  hostingAccountId String?         @db.Char(36)
  scheduleId       String?         @db.Char(36)
  name             String          @db.VarChar(255)
  filePath         String?         @db.VarChar(255)
  fileSizeMb       Decimal?        @db.Decimal(10, 2)
  status           BackupStatus    @default(PENDING)
  backupType       String          @default("DATABASE")
  isFull           Boolean         @default(true)
  isEncrypted      Boolean         @default(false)
  restoreTested    Boolean         @default(false)
  restorePoint     Boolean         @default(false)
  completedAt      DateTime?       @db.Timestamp(0)
  createdAt        DateTime        @default(now()) @db.Timestamp(0)
  hostingAccount   HostingAccount? @relation(fields: [hostingAccountId], references: [id])
  schedule         BackupSchedule? @relation(fields: [scheduleId], references: [id])
  server           Server?         @relation(fields: [serverId], references: [id])

  @@index([hostingAccountId], map: "backups_hostingAccountId_fkey")
  @@index([scheduleId], map: "backups_scheduleId_fkey")
  @@index([serverId], map: "backups_serverId_fkey")
  @@map("backups")
}

model BackupSchedule {
  id               String          @id @default(uuid()) @db.Char(36)
  serverId         String?         @db.Char(36)
  hostingAccountId String?         @db.Char(36)
  name             String          @db.VarChar(100)
  frequency        String          @db.VarChar(50)
  retentionDays    Int             @default(30)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now()) @db.Timestamp(0)
  updatedAt        DateTime        @updatedAt @db.Timestamp(0)
  hostingAccount   HostingAccount? @relation(fields: [hostingAccountId], references: [id])
  server           Server?         @relation(fields: [serverId], references: [id])
  backups          Backup[]

  @@index([hostingAccountId], map: "backup_schedules_hostingAccountId_fkey")
  @@index([serverId], map: "backup_schedules_serverId_fkey")
  @@map("backup_schedules")
}

model MonitoringCheck {
  id               String           @id @default(uuid()) @db.Char(36)
  serverId         String?          @db.Char(36)
  domainId         String?          @db.Char(36)
  sslCertificateId String?          @db.Char(36)
  name             String           @db.VarChar(100)
  checkType        String           @db.VarChar(50)
  value            String?          @db.VarChar(100)
  cpuUsage         Decimal?         @db.Decimal(5, 2)
  ramUsage         Decimal?         @db.Decimal(5, 2)
  diskUsage        Decimal?         @db.Decimal(5, 2)
  loadAverage      Decimal?         @db.Decimal(5, 2)
  networkInKbps    Decimal?         @db.Decimal(10, 2)
  networkOutKbps   Decimal?         @db.Decimal(10, 2)
  responseTimeMs   Int?
  lastCheckedAt    DateTime?        @db.Timestamp(0)
  status           MonitoringStatus @default(HEALTHY)
  createdAt        DateTime         @default(now()) @db.Timestamp(0)
  updatedAt        DateTime         @updatedAt @db.Timestamp(0)
  domain           Domain?          @relation(fields: [domainId], references: [id])
  server           Server?          @relation(fields: [serverId], references: [id])
  sslCertificate   SSLCertificate?  @relation(fields: [sslCertificateId], references: [id])

  @@index([domainId], map: "monitoring_checks_domainId_fkey")
  @@index([serverId], map: "monitoring_checks_serverId_fkey")
  @@index([sslCertificateId], map: "monitoring_checks_sslCertificateId_fkey")
  @@map("monitoring_checks")
}

model Incident {
