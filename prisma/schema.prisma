enum InfrastructureStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  EXPIRED
  FAILED
}

enum ServerType {
  SHARED
  VPS
  DEDICATED
  CLOUD
  CONTAINER
}

enum Environment {
  DEVELOPMENT
  TESTING
  STAGING
  PRODUCTION
}

enum DeploymentStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  ROLLBACK
}

enum BackupStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum MonitoringStatus {
  HEALTHY
  WARNING
  CRITICAL
}

model InfrastructureProvider {
  id              String           @id @default(uuid()) @db.Char(36)
  name            String           @db.VarChar(255)
  code            String           @unique @db.VarChar(100)
  apiEndpoint     String?          @db.VarChar(255)
  status          Status           @default(ACTIVE)
  hostingAccounts HostingAccount[]
  hostingPlans    HostingPlan[]
  servers         Server[]
  createdAt       DateTime         @default(now()) @db.Timestamp
  updatedAt       DateTime         @updatedAt @db.Timestamp

  @@map("infrastructure_providers")
}

model HostingAccount {
  id               String                 @id @default(uuid()) @db.Char(36)
  clientId         String?                @db.Char(36)
  client           Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId        String?                @db.Char(36)
  project          Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  providerId       String                 @db.Char(36)
  provider         InfrastructureProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  accountUsername  String                 @db.VarChar(100)
  controlPanelUrl  String?                @db.VarChar(255)
  status           InfrastructureStatus   @default(ACTIVE)
  hostingPlanId    String?                @db.Char(36)
  hostingPlan      HostingPlan?           @relation(fields: [hostingPlanId], references: [id], onDelete: SetNull)
  diskLimitGb      Decimal?               @db.Decimal(10, 2)
  diskUsedGb       Decimal?               @db.Decimal(10, 2)
  bandwidthLimitGb Decimal?               @db.Decimal(10, 2)
  bandwidthUsedGb  Decimal?               @db.Decimal(10, 2)
  notes            String?                @db.Text
  backups          Backup[]
  backupSchedules  BackupSchedule[]
  credentials      InfrastructureCredential[]
  createdAt        DateTime               @default(now()) @db.Timestamp
  updatedAt        DateTime               @updatedAt @db.Timestamp

  @@map("hosting_accounts")
}

model HostingPlan {
  id           String                 @id @default(uuid()) @db.Char(36)
  providerId   String                 @db.Char(36)
  provider     InfrastructureProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name         String                 @db.VarChar(100)
  diskGb       Int
  ramGb        Decimal                @db.Decimal(10, 2)
  cpuCores     Int
  bandwidthGb  Int
  priceMonthly Decimal?               @db.Decimal(10, 2)
  accounts     HostingAccount[]
  createdAt    DateTime               @default(now()) @db.Timestamp
  updatedAt    DateTime               @updatedAt @db.Timestamp

  @@map("hosting_plans")
}

model Server {
  id                 String                 @id @default(uuid()) @db.Char(36)
  name               String                 @db.VarChar(255)
  ipAddress          String                 @db.VarChar(50)
  sshPort            Int                    @default(22)
  os                 String                 @db.VarChar(100)
  location           String?                @db.VarChar(100)
  providerId         String?                @db.Char(36)
  provider           InfrastructureProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  type               ServerType             @default(VPS)
  status             InfrastructureStatus   @default(ACTIVE)
  diskGb             Int?
  ramGb              Decimal?               @db.Decimal(10, 2)
  cpuCores           Int?
  clientId           String?                @db.Char(36)
  client             Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId          String?                @db.Char(36)
  project            Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  serverEnvironments ServerEnvironment[]
  backups            Backup[]
  backupSchedules    BackupSchedule[]
  monitoringChecks   MonitoringCheck[]
  incidents          Incident[]
  credentials        InfrastructureCredential[]
  tags               InfrastructureTag[]    @relation("ServerToInfraTags")
  createdAt          DateTime               @default(now()) @db.Timestamp
  updatedAt          DateTime               @updatedAt @db.Timestamp

  @@map("servers")
}

model ServerEnvironment {
  id          String               @id @default(uuid()) @db.Char(36)
  serverId    String               @db.Char(36)
  server      Server               @relation(fields: [serverId], references: [id], onDelete: Cascade)
  projectId   String?              @db.Char(36)
  project     Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  environment Environment
  name        String               @db.VarChar(100)
  domainName  String?              @db.VarChar(255)
  status      InfrastructureStatus @default(ACTIVE)
  deployments Deployment[]
  createdAt   DateTime             @default(now()) @db.Timestamp
  updatedAt   DateTime             @updatedAt @db.Timestamp

  @@map("server_environments")
}

model Deployment {
  id                         String            @id @default(uuid()) @db.Char(36)
  projectId                  String            @db.Char(36)
  project                    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serverEnvironmentId        String            @db.Char(36)
  serverEnvironment          ServerEnvironment @relation(fields: [serverEnvironmentId], references: [id], onDelete: Cascade)
  repositoryBranchId         String?           @db.Char(36)
  repositoryBranch           RepositoryBranch? @relation(fields: [repositoryBranchId], references: [id], onDelete: SetNull)
  commitHash                 String?           @db.VarChar(100)
  startedById                String            @db.Char(36)
  startedBy                  User              @relation("UserDeployments", fields: [startedById], references: [id], onDelete: Restrict)
  status                     DeploymentStatus  @default(PENDING)
  rollbackSupport            Boolean           @default(true)
  duration                   Int? // in seconds
  rollbackReason             String?           @db.Text
  buildLogs                  String?           @db.LongText
  environmentVariableVersion Int               @default(1)
  startedAt                  DateTime          @default(now()) @db.Timestamp
  finishedAt                 DateTime?         @db.Timestamp
  historyLogs                DeploymentHistory[]
  createdAt                  DateTime          @default(now()) @db.Timestamp
  updatedAt                  DateTime          @updatedAt @db.Timestamp

  @@map("deployments")
}

model DeploymentHistory {
  id           String           @id @default(uuid()) @db.Char(36)
  deploymentId String           @db.Char(36)
  deployment   Deployment       @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  logMessage   String           @db.Text
  status       DeploymentStatus
  createdAt    DateTime         @default(now()) @db.Timestamp

  @@map("deployment_histories")
}

model Repository {
  id              String             @id @default(uuid()) @db.Char(36)
  projectId       String?            @db.Char(36)
  project         Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name            String             @db.VarChar(255)
  url             String             @db.VarChar(255)
  owner           String?            @db.VarChar(100)
  visibility      String             @default("PRIVATE") // PUBLIC, PRIVATE
  primaryLanguage String?            @db.VarChar(50)
  defaultBranch   String             @default("main") @db.VarChar(100)
  lastCommit      String?            @db.VarChar(100)
  lastSync        DateTime?          @db.Timestamp
  webhookEnabled  Boolean            @default(false)
  branches        RepositoryBranch[]
  createdAt       DateTime           @default(now()) @db.Timestamp
  updatedAt       DateTime           @updatedAt @db.Timestamp

  @@map("repositories")
}

model RepositoryBranch {
  id           String       @id @default(uuid()) @db.Char(36)
  repositoryId String       @db.Char(36)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  name         String       @db.VarChar(100)
  deployments  Deployment[]
  createdAt    DateTime     @default(now()) @db.Timestamp
  updatedAt    DateTime     @updatedAt @db.Timestamp

  @@map("repository_branches")
}

model Domain {
  id                  String                 @id @default(uuid()) @db.Char(36)
  clientId            String?                @db.Char(36)
  client              Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId           String?                @db.Char(36)
  project             Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name                String                 @unique @db.VarChar(255)
  registrar           String                 @db.VarChar(100)
  purchaseDate        DateTime               @db.Date
  expiryDate          DateTime               @db.Date
  autoRenew           Boolean                @default(true)
  privacyProtection   Boolean                @default(false)
  registrarLock       Boolean                @default(true)
  transferLock        Boolean                @default(true)
  purchaseCost        Decimal?               @db.Decimal(10, 2)
  renewalCost         Decimal?               @db.Decimal(10, 2)
  renewalReminderDays Int                    @default(30)
  whoisRaw            String?                @db.Text
  dnsSecEnabled       Boolean                @default(false)
  nameservers         String?                @db.VarChar(512)
  status              InfrastructureStatus   @default(ACTIVE)
  subDomains          SubDomain[]
  dnsRecords          DNSRecord[]
  sslCertificates     SSLCertificate[]
  monitoringChecks    MonitoringCheck[]
  incidents           Incident[]
  credentials         InfrastructureCredential[]
  tags                InfrastructureTag[]    @relation("DomainToInfraTags")
  createdAt           DateTime               @default(now()) @db.Timestamp
  updatedAt           DateTime               @updatedAt @db.Timestamp

  @@map("domains")
}

model SubDomain {
  id              String               @id @default(uuid()) @db.Char(36)
  domainId        String               @db.Char(36)
  domain          Domain               @relation(fields: [domainId], references: [id], onDelete: Cascade)
  name            String               @db.VarChar(100)
  targetIp        String?              @db.VarChar(50)
  status          InfrastructureStatus @default(ACTIVE)
  sslCertificates SSLCertificate[]
  createdAt       DateTime             @default(now()) @db.Timestamp
  updatedAt       DateTime             @updatedAt @db.Timestamp

  @@map("sub_domains")
}

model DNSRecord {
  id        String   @id @default(uuid()) @db.Char(36)
  domainId  String   @db.Char(36)
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  type      String   @db.VarChar(20) // A, CNAME, TXT, MX, NS
  host      String   @db.VarChar(255)
  value     String   @db.Text
  ttl       Int      @default(3600)
  priority  Int?
  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @updatedAt @db.Timestamp

  @@map("dns_records")
}

model SSLCertificate {
  id               String               @id @default(uuid()) @db.Char(36)
  domainId         String?              @db.Char(36)
  domain           Domain?              @relation(fields: [domainId], references: [id], onDelete: SetNull)
  subDomainId      String?              @db.Char(36)
  subDomain        SubDomain?           @relation(fields: [subDomainId], references: [id], onDelete: SetNull)
  issuer           String               @db.VarChar(100) // LETS_ENCRYPT, CLOUDFLARE, SECTIGO, DIGICERT, CUSTOM
  issuedDate       DateTime             @db.Date
  expiryDate       DateTime             @db.Date
  wildcard         Boolean              @default(false)
  autoRenewal      Boolean              @default(false)
  daysRemaining    Int?
  renewalStatus    String               @default("GOOD") // GOOD, WARNING, EXPIRED
  status           InfrastructureStatus @default(ACTIVE)
  monitoringChecks MonitoringCheck[]
  createdAt        DateTime             @default(now()) @db.Timestamp
  updatedAt        DateTime             @updatedAt @db.Timestamp

  @@map("ssl_certificates")
}

model Backup {
  id               String               @id @default(uuid()) @db.Char(36)
  serverId         String?              @db.Char(36)
  server           Server?              @relation(fields: [serverId], references: [id], onDelete: SetNull)
  hostingAccountId String?              @db.Char(36)
  hostingAccount   HostingAccount?      @relation(fields: [hostingAccountId], references: [id], onDelete: SetNull)
  scheduleId       String?              @db.Char(36)
  schedule         BackupSchedule?      @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  name             String               @db.VarChar(255)
  filePath         String?              @db.VarChar(255)
  fileSizeMb       Decimal?             @db.Decimal(10, 2)
  status           BackupStatus         @default(PENDING)
  backupType       String               @default("DATABASE") // DATABASE, FILES
  isFull           Boolean              @default(true) // Full vs Incremental
  isEncrypted      Boolean              @default(false)
  restoreTested    Boolean              @default(false)
  restorePoint     Boolean              @default(false)
  completedAt      DateTime?            @db.Timestamp
  createdAt        DateTime             @default(now()) @db.Timestamp

  @@map("backups")
}

model BackupSchedule {
  id               String          @id @default(uuid()) @db.Char(36)
  serverId         String?         @db.Char(36)
  server           Server?         @relation(fields: [serverId], references: [id], onDelete: SetNull)
  hostingAccountId String?         @db.Char(36)
  hostingAccount   HostingAccount? @relation(fields: [hostingAccountId], references: [id], onDelete: SetNull)
  name             String          @db.VarChar(100)
  frequency        String          @db.VarChar(50) // DAILY, WEEKLY, MONTHLY
  retentionDays    Int             @default(30)
  isActive         Boolean         @default(true)
  backups          Backup[]
  createdAt        DateTime        @default(now()) @db.Timestamp
  updatedAt        DateTime        @updatedAt @db.Timestamp

  @@map("backup_schedules")
}

model MonitoringCheck {
  id               String           @id @default(uuid()) @db.Char(36)
  serverId         String?          @db.Char(36)
  server           Server?          @relation(fields: [serverId], references: [id], onDelete: SetNull)
  domainId         String?          @db.Char(36)
  domain           Domain?          @relation(fields: [domainId], references: [id], onDelete: SetNull)
  sslCertificateId String?          @db.Char(36)
